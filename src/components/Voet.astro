---
import { Image } from 'astro:assets';
import { site, url, waAfspraak } from '../data/site';
import pand from '../assets/pand.jpg';
---
<footer id="contact" class="donker bg-nacht text-licht" aria-labelledby="t-contact">
  <div class="wrap grid gap-y-14 pb-16 pt-20 md:grid-cols-12 md:gap-x-8 lg:pb-24 lg:pt-32">
    <div class="md:col-span-5">
      <p class="ui text-messing-licht">Afspraak maken</p>
      <h2 id="t-contact" class="mt-5">Een afspraak begint met een bericht.</h2>
      <p class="mt-6 max-w-md text-licht-zacht">Ik ontvang u alleen op afspraak. Bellen mag, maar tijdens het werk neem ik meestal niet op. Een WhatsApp-bericht of e-mail met een paar foto's werkt het best.</p>
      <ul class="mt-10 max-w-md divide-y divide-lijn-licht border-y border-lijn-licht">
        <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4"><span class="text-sm text-licht-zacht">WhatsApp</span><a href={waAfspraak} class="lijn-in num">{site.tel}</a></li>
        <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4"><span class="text-sm text-licht-zacht">Bellen</span><a href={site.telHref} class="lijn-in num">{site.tel}</a></li>
        <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4"><span class="text-sm text-licht-zacht">E-mail</span><a href={`mailto:${site.mail}`} class="lijn-in break-all">{site.mail}</a></li>
      </ul>
    </div>

    <form class="md:col-span-7 lg:col-span-6 lg:col-start-7" data-wa aria-describedby="wa-uitleg">
      <p id="wa-uitleg" class="ui text-licht-zacht">Uw bericht aan Hugo, via WhatsApp</p>
      <div class="mt-6 grid gap-x-8 sm:grid-cols-2">
        <label class="veld"><span>Merk</span><input name="merk" autocomplete="off" placeholder="Bijvoorbeeld Omega" /></label>
        <label class="veld"><span>Type</span>
          <select name="type">
            <option value="">Weet ik niet</option>
            <option>Automaat</option>
            <option>Quartz</option>
            <option>Chronograaf</option>
          </select>
        </label>
        <label class="veld sm:col-span-2"><span>Referentienummer <em class="not-italic text-licht-zacht">(als u het weet)</em></span><input name="ref" autocomplete="off" /></label>
        <label class="veld sm:col-span-2"><span>Wat is er aan de hand?</span><textarea name="vraag" rows="2" placeholder="Bijvoorbeeld: loopt achter, toe aan een servicebeurt"></textarea></label>
      </div>
      <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a href={waAfspraak} class="knop knop-vol" data-wa-knop>Open in WhatsApp</a>
        <p class="text-sm text-licht-zacht">Foto's stuurt u daarna mee in WhatsApp.</p>
      </div>
    </form>

    <div class="grid gap-12 border-t border-lijn-licht pt-14 sm:grid-cols-3 md:col-span-12 lg:grid-cols-12 lg:gap-x-8">
      <div class="lg:col-span-3">
        <p class="ui text-licht-zacht">Adres</p>
        <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
        <a href={site.maps} class="lijn mt-4 inline-block text-sm">Route in Google Maps</a>
      </div>
      <div class="lg:col-span-3">
        <p class="ui text-licht-zacht">Open</p>
        <p class="mt-4">Alleen op afspraak</p>
      </div>
      <div class="lg:col-span-3">
        <p class="ui text-licht-zacht">Volgen</p>
        <p class="mt-4"><a href={site.instagram} class="lijn-in">Instagram</a></p>
      </div>
      <figure class="sm:col-span-3 lg:col-span-2 lg:col-start-11">
        <Image src={pand} alt="De voordeur van het pand aan de Dijk 126 in Herten" widths={[320, 505]} sizes="(min-width: 1024px) 14vw, 12rem" class="aspect-[4/5] w-48 object-cover lg:w-full" />
        <figcaption class="mt-3 text-xs text-licht-zacht">{site.straat}, {site.plaats}</figcaption>
      </figure>
    </div>
  </div>

  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-3 border-t border-lijn-licht py-7 text-xs text-licht-zacht">
    <p>{site.naam}, {site.plaats}. KvK [[AANLEVEREN: KvK-nummer]]. Btw-id [[AANLEVEREN: btw-nummer]]</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2">
      <a href={url('privacy/')} class="lijn-in">Privacyverklaring</a>
    </p>
  </div>
</footer>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  const k = document.querySelector<HTMLAnchorElement>('[data-wa-knop]');
  if (f && k) {
    const basis = k.href.split('?')[0];
    const bouw = () => {
      const d = new FormData(f);
      const r = ['Goedendag, ik wil graag een afspraak maken voor mijn horloge.'];
      const v = (n: string) => String(d.get(n) || '').trim();
      if (v('merk')) r.push('Merk: ' + v('merk'));
      if (v('type')) r.push('Type: ' + v('type'));
      if (v('ref')) r.push('Referentienummer: ' + v('ref'));
      if (v('vraag')) r.push('Wat er aan de hand is: ' + v('vraag'));
      if (r.length > 1) r.push('Foto’s stuur ik hierna mee.');
      k.href = basis + '?text=' + encodeURIComponent(r.join('\n'));
    };
    f.addEventListener('input', bouw);
    f.addEventListener('change', bouw);
    f.addEventListener('submit', (e) => { e.preventDefault(); bouw(); k.click(); });
  }
</script>

<style>
  .veld { display: block; padding-block: .25rem 1.5rem; }
  .veld > span { display: block; font-size: var(--text-sm); color: var(--color-licht-zacht); }
  .veld input, .veld select, .veld textarea { display: block; width: 100%; margin-top: .4rem; padding: .55rem 0; background: transparent; color: var(--color-licht); border: 0; border-bottom: 1px solid #f5f1ea66; border-radius: 0; font: inherit; transition: border-color .3s; resize: vertical; }
  .veld select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%); background-position: calc(100% - 10px) 55%, calc(100% - 5px) 55%; background-size: 5px 5px; background-repeat: no-repeat; }
  .veld select option { color: #14213b; }
  .veld input::placeholder, .veld textarea::placeholder { color: #f5f1ea8c; }
  .veld input:focus, .veld select:focus, .veld textarea:focus { outline: none; border-bottom-color: var(--color-messing-licht); }
  .veld input:focus-visible, .veld select:focus-visible, .veld textarea:focus-visible { outline: 2px solid var(--color-licht); outline-offset: 4px; }
</style>
