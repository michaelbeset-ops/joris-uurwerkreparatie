---
// Afspraakkaart in de merkkleur (links uitleg en kanalen, rechts het berichtformulier), een afsluitende vraag,
// de footer en op mobiel een vaste balk met bellen en afspraak.
import { Image } from 'astro:assets';
import Icoon from './Icoon.astro';
import Logo from './Logo.astro';
import { site, url, waAfspraak } from '../data/site';
import pand from '../assets/pand.jpg';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
---
<section id="contact" class="wrap scroll-mt-28 py-16 lg:py-24" aria-labelledby="t-contact">
  <div class="donker grid grid-cols-1 overflow-hidden rounded-2xl bg-marine text-wit shadow-kaart lg:grid-cols-12">
    <div class="min-w-0 p-6 md:p-10 lg:col-span-5 lg:p-12">
      <p class="kicker text-staal">Afspraak maken</p>
      <h2 id="t-contact" class="mt-3 text-3xl text-wit">Vertel wat er met uw horloge is.</h2>
      <p class="mt-5 text-staal">Ik ontvang u alleen op afspraak. Bellen mag, maar tijdens het werk neem ik meestal niet op. Een bericht met een paar foto's werkt het best.</p>
      <ol class="mt-8 grid gap-4">
        {['U stuurt uw bericht, met foto’s als u die heeft.', 'Ik neem contact op en we plannen een afspraak in Herten.', 'Na onderzoek krijgt u een prijsopgave. Pas na uw akkoord begin ik.'].map((t, i) => (
          <li class="flex gap-3"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-pill bg-wit/15 font-display text-sm font-bold">{i + 1}</span><span>{t}</span></li>
        ))}
      </ol>
      <ul class="mt-10 grid gap-3">
        <li><a href={waAfspraak} class="flex items-center gap-3 rounded-md bg-wit/10 px-4 py-3 no-underline hover:bg-wit/15"><Icoon naam="bericht" /><span><span class="block text-sm text-staal">WhatsApp</span><span class="num font-display font-bold">{site.tel}</span></span></a></li>
        <li><a href={site.telHref} class="flex items-center gap-3 rounded-md bg-wit/10 px-4 py-3 no-underline hover:bg-wit/15"><Icoon naam="telefoon" /><span><span class="block text-sm text-staal">Bellen</span><span class="num font-display font-bold">{site.tel}</span></span></a></li>
        <li><a href={`mailto:${site.mail}`} class="flex items-center gap-3 rounded-md bg-wit/10 px-4 py-3 no-underline hover:bg-wit/15"><Icoon naam="mail" /><span class="min-w-0"><span class="block text-sm text-staal">E-mail</span><span class="block break-all font-display font-bold">{site.mail}</span></span></a></li>
      </ul>
    </div>

    <form class="min-w-0 bg-wit p-6 text-ink md:p-10 lg:col-span-7 lg:p-12" data-wa aria-describedby="wa-uitleg">
      <h3 class="text-xl">Uw bericht aan Hugo</h3>
      <p id="wa-uitleg" class="mt-2 text-ink-zacht">Vul in wat u weet. De knop opent WhatsApp of uw mail met het bericht al ingevuld. Er wordt niets verstuurd voordat u dat zelf doet.</p>
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        <div><label for="f-merk" class="text-sm font-medium">Merk</label><input id="f-merk" name="merk" autocomplete="off" placeholder="Bijvoorbeeld Omega" class="veld mt-1.5" /></div>
        <div><label for="f-type" class="text-sm font-medium">Type</label>
          <select id="f-type" name="type" class="veld mt-1.5">
            <option value="">Weet ik niet</option><option>Automaat</option><option>Quartz</option><option>Chronograaf</option>
          </select>
        </div>
        <div><label for="f-ref" class="text-sm font-medium">Model of referentienummer</label><input id="f-ref" name="ref" autocomplete="off" placeholder="Bijvoorbeeld Speedmaster 3861" class="veld mt-1.5" /></div>
        <div><label for="f-band" class="text-sm font-medium">Soort band</label><input id="f-band" name="band" autocomplete="off" placeholder="Staal, leer of rubber" class="veld mt-1.5" /></div>
        <div><label for="f-sinds" class="text-sm font-medium">Sinds wanneer?</label><input id="f-sinds" name="sinds" autocomplete="off" placeholder="Bijvoorbeeld: sinds een week" class="veld mt-1.5" /></div>
        <div><label for="f-contact" class="text-sm font-medium">Liefst contact via</label><select id="f-contact" name="contact" class="veld mt-1.5"><option>WhatsApp</option><option>Telefoon</option><option>E-mail</option></select></div>
        <div class="sm:col-span-2"><label for="f-vraag" class="text-sm font-medium">Wat is er aan de hand?</label><textarea id="f-vraag" name="vraag" rows="4" placeholder="Bijvoorbeeld: loopt achter, toe aan een servicebeurt of glas gebroken" class="veld mt-1.5"></textarea></div>
      </div>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a href={waAfspraak} class="btn btn-marine" data-wa-knop><Icoon naam="bericht" maat={20} />Verstuur via WhatsApp</a>
        <a href={`mailto:${site.mail}`} class="btn btn-wit" data-mail-knop><Icoon naam="mail" maat={20} />Of per e-mail</a>
      </div>
      <p class="mt-4 text-sm text-ink-zacht">Foto's van de voor- en achterkant voegt u daarna toe in WhatsApp of uw mail.</p>
    </form>
  </div>
</section>

<footer class="donker bg-marine-diep text-wit">
  <div class="wrap">
    <div class="flex flex-col gap-6 border-b border-wit/15 py-12 md:flex-row md:items-center md:justify-between lg:py-16">
      <p class="font-display text-3xl font-extrabold leading-none tracking-[-0.025em]">Vragen over uw horloge?</p>
      <div class="flex flex-wrap gap-3">
        <a href={h('contact')} class="btn bg-wit text-marine hover:bg-ijs">Afspraak maken</a>
        <a href={site.telHref} class="btn btn-glas"><Icoon naam="telefoon" maat={18} /><span class="num">{site.tel}</span></a>
      </div>
    </div>
    <div class="grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <Logo licht />
        <p class="mt-3 max-w-xs text-staal">Officieel Omega Service Center en servicecenter voor Longines en Rado.</p>
        <p class="mt-3 text-sm"><a href={site.omegaLocator} target="_blank" rel="noopener" class="text-staal underline hover:text-wit">Bekijk de OMEGA-vermelding<span class="sr-only"> (opent in een nieuw tabblad)</span></a></p>
        {(site.kvk || site.btw) && <p class="mt-4 text-sm text-staal">{site.kvk && <>KvK {site.kvk}<br /></>}{site.btw && <>Btw-id {site.btw}</>}</p>}
      </div>
      <div class="lg:col-span-3">
        <p class="kicker text-staal">Contact</p>
        <ul class="mt-4 grid gap-2">
          <li><a href={waAfspraak} class="no-underline hover:underline">WhatsApp</a></li>
          <li><a href={site.telHref} class="num no-underline hover:underline">{site.tel}</a></li>
          <li><a href={`mailto:${site.mail}`} class="break-all no-underline hover:underline">{site.mail}</a></li>
          <li><a href={site.instagram} target="_blank" rel="noopener" class="no-underline hover:underline">Instagram<span class="sr-only"> (opent in een nieuw tabblad)</span></a></li>
        </ul>
      </div>
      <div class="lg:col-span-3">
        <p class="kicker text-staal">Werkplaats</p>
        <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}<br /><span class="text-staal">Alleen op afspraak</span></p>
        <a href={site.maps} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-2 no-underline hover:underline"><Icoon naam="pin" maat={18} />Route plannen<span class="sr-only"> (opent in een nieuw tabblad)</span></a>
      </div>
      <figure class="lg:col-span-2">
        <Image src={pand} alt="De voordeur van het pand aan de Dijk 126 in Herten" widths={[320, 505]} sizes="(min-width: 1024px) 12rem, 10rem" class="aspect-[4/5] w-40 rounded-md object-cover lg:w-full" />
      </figure>
    </div>
  </div>
  <div class="border-t border-wit/15 pb-24 md:pb-0">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-5 text-sm text-staal">
      <p>&copy; {site.naam}, {site.plaats}. Rolex is een geregistreerd merk van Rolex SA.</p>
      <p class="flex gap-5"><a href={url('privacy/')} class="no-underline hover:underline">Privacyverklaring</a><a href="https://www.sitefront.nl" target="_blank" rel="noopener" class="no-underline hover:underline">Website door Sitefront</a></p>
    </div>
  </div>
</footer>

<!-- Vaste balk onderaan op mobiel: altijd binnen handbereik. -->
<div class="fixed inset-x-0 bottom-0 z-30 grid grid-cols-2 gap-2 border-t border-lijn bg-wit/95 p-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] backdrop-blur-sm md:hidden">
  <a href={site.telHref} class="btn btn-wit !min-h-12 !px-2"><Icoon naam="telefoon" maat={18} />Bellen</a>
  <a href={h('contact')} class="btn btn-marine !min-h-12 !px-2">Afspraak maken</a>
</div>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  const k = document.querySelector<HTMLAnchorElement>('[data-wa-knop]');
  const m = document.querySelector<HTMLAnchorElement>('[data-mail-knop]');
  if (f && k) {
    const basis = k.href.split('?')[0];
    const mailBasis = m?.href.split('?')[0] ?? '';
    const bouw = () => {
      const d = new FormData(f);
      const r = ['Goedendag, ik wil graag een afspraak maken voor mijn horloge.'];
      const v = (n: string) => String(d.get(n) || '').trim();
      if (v('merk')) r.push('Merk: ' + v('merk'));
      if (v('type')) r.push('Type: ' + v('type'));
      if (v('ref')) r.push('Model of referentienummer: ' + v('ref'));
      if (v('band')) r.push('Band: ' + v('band'));
      if (v('vraag')) r.push('Wat er aan de hand is: ' + v('vraag'));
      if (v('sinds')) r.push('Sinds: ' + v('sinds'));
      if (r.length > 1 && v('contact')) r.push('Contact liefst via: ' + v('contact'));
      if (r.length > 1) r.push('Foto’s stuur ik hierna mee.');
      k.href = basis + '?text=' + encodeURIComponent(r.join('\n'));
      if (m) m.href = mailBasis + '?subject=' + encodeURIComponent('Afspraak voor mijn horloge') + '&body=' + encodeURIComponent(r.join('\n'));
    };
    f.addEventListener('input', bouw);
    f.addEventListener('change', bouw);
    f.addEventListener('submit', (e) => { e.preventDefault(); bouw(); k.click(); });
  }
</script>
