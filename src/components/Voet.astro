---
// Afspraakblok (donker), afsluiter, dichte footer en op mobiel een vaste balk met WhatsApp en Afspraak.
import { Image } from 'astro:assets';
import { site, url, waAfspraak } from '../data/site';
import pand from '../assets/pand.jpg';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
---
<section id="contact" class="donker scroll-mt-24 bg-nacht text-licht" aria-labelledby="t-contact">
  <div class="wrap grid gap-10 py-16 lg:grid-cols-12 lg:gap-8 lg:py-24">
    <div class="lg:col-span-5">
      <p class="ui text-messing-licht">Afspraak maken</p>
      <h2 id="t-contact" class="mt-4">Een afspraak begint met een bericht.</h2>
      <p class="mt-5 max-w-md text-licht-zacht">Ik ontvang u alleen op afspraak. Bellen mag, maar tijdens het werk neem ik meestal niet op. Een WhatsApp-bericht of e-mail met een paar foto's werkt het best.</p>
      <ul class="mt-8 grid gap-3 text-sm">
        {['Stuur merk, type en wat er aan de hand is', 'Foto’s van voor- en achterkant helpen', 'U krijgt eerst een onderzoek, dan een prijsopgave'].map((t) => (
          <li class="flex items-start gap-3"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-messing-licht"><path d="M4 12.5l5 5L20 6.5"/></svg>{t}</li>
        ))}
      </ul>
      <dl class="mt-10 grid gap-5 border-t border-lijn-licht pt-8 sm:grid-cols-2">
        <div><dt class="ui text-licht-zacht">WhatsApp en bellen</dt><dd class="mt-2"><a href={waAfspraak} class="kop-serif num text-k3 hover:underline">{site.tel}</a></dd></div>
        <div><dt class="ui text-licht-zacht">E-mail</dt><dd class="mt-2"><a href={`mailto:${site.mail}`} class="break-all hover:underline">{site.mail}</a></dd></div>
        <div><dt class="ui text-licht-zacht">Werkplaats</dt><dd class="mt-2">{site.straat}<br />{site.postcode} {site.plaats}<br /><a href={site.maps} target="_blank" rel="noopener" class="underline">Route in Google Maps<span class="sr-only"> (opent in een nieuw tabblad)</span></a></dd></div>
        <div><dt class="ui text-licht-zacht">Open</dt><dd class="mt-2">Alleen op afspraak</dd></div>
      </dl>
    </div>

    <form class="kaart p-6 sm:p-8 lg:col-span-7" data-wa aria-describedby="wa-uitleg">
      <p class="ui text-messing-licht">Uw bericht aan Hugo</p>
      <p id="wa-uitleg" class="mt-3 text-sm text-licht-zacht">Vul in wat u weet. De knop opent WhatsApp met uw bericht al ingevuld; foto's voegt u daar toe. Er wordt niets verstuurd voordat u dat zelf doet.</p>
      <div class="mt-6 grid gap-x-6 sm:grid-cols-2">
        <label class="veld"><span>Merk</span><input name="merk" autocomplete="off" placeholder="Bijvoorbeeld Omega" /></label>
        <label class="veld"><span>Type</span>
          <select name="type">
            <option value="">Weet ik niet</option>
            <option>Automaat</option>
            <option>Quartz</option>
            <option>Chronograaf</option>
          </select>
        </label>
        <label class="veld"><span>Model of referentienummer <em class="not-italic text-licht-zacht">(als u het weet)</em></span><input name="ref" autocomplete="off" placeholder="Bijvoorbeeld Speedmaster 3861" /></label>
        <label class="veld"><span>Soort band</span><input name="band" autocomplete="off" placeholder="Staal, leer, rubber" /></label>
        <label class="veld sm:col-span-2"><span>Wat is er aan de hand?</span><textarea name="vraag" rows="3" placeholder="Bijvoorbeeld: loopt achter, toe aan een servicebeurt, glas gebroken"></textarea></label>
      </div>
      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a href={waAfspraak} class="knop knop-vol" data-wa-knop>Open in WhatsApp</a>
        <a href={`mailto:${site.mail}`} class="knop knop-glas" data-mail-knop>Liever mailen</a>
      </div>
    </form>
  </div>
</section>

<!-- Afsluiter: een grote vraag en de twee knoppen. -->
<section class="bg-vlak" aria-label="Afsluiting">
  <div class="wrap flex flex-col gap-6 py-14 md:flex-row md:items-center md:justify-between lg:py-20">
    <h2 class="max-w-[24ch]">Toe aan een servicebeurt of een reparatie?</h2>
    <div class="flex flex-wrap gap-3">
      <a href={h('contact')} class="knop knop-vol">Afspraak maken</a>
      <a href={site.telHref} class="knop knop-licht num">Bel {site.tel}</a>
    </div>
  </div>
</section>

<footer class="border-t border-lijn bg-papier pb-24 md:pb-0">
  <div class="wrap grid gap-10 py-14 md:grid-cols-12 md:gap-6">
    <div class="md:col-span-4">
      <a href={url('')} class="merk !items-start"><b>JORIS</b><small>Uurwerkreparatie</small></a>
      <p class="mt-5 max-w-xs text-sm text-tekst">Officieel Omega Service Center en servicecenter voor Longines en Rado. Onderhoud en reparatie van horloges met originele onderdelen.</p>
      <p class="mt-4 text-sm text-tekst">KvK [[AANLEVEREN: KvK-nummer]]<br />Btw-id [[AANLEVEREN: btw-nummer]]</p>
    </div>
    <div class="text-sm md:col-span-3">
      <p class="ui text-messing">Contact</p>
      <ul class="mt-3 grid gap-1.5">
        <li><a href={waAfspraak} class="inline-block py-0.5 underline">WhatsApp</a></li>
        <li><a href={site.telHref} class="num inline-block py-0.5 underline">{site.tel}</a></li>
        <li><a href={`mailto:${site.mail}`} class="inline-block break-all py-0.5 underline">{site.mail}</a></li>
        <li><a href={site.instagram} target="_blank" rel="noopener" class="inline-block py-0.5 underline">Instagram<span class="sr-only"> (opent in een nieuw tabblad)</span></a></li>
      </ul>
    </div>
    <div class="text-sm md:col-span-3">
      <p class="ui text-messing">Werkplaats</p>
      <p class="mt-3">{site.straat}<br />{site.postcode} {site.plaats}<br />Alleen op afspraak</p>
      <p class="mt-3"><a href={site.maps} target="_blank" rel="noopener" class="inline-block py-0.5 underline">Route in Google Maps<span class="sr-only"> (opent in een nieuw tabblad)</span></a></p>
    </div>
    <figure class="md:col-span-2">
      <Image src={pand} alt="De voordeur van het pand aan de Dijk 126 in Herten" widths={[320, 505]} sizes="(min-width: 768px) 14vw, 10rem" class="aspect-[4/5] w-40 object-cover md:w-full" />
      <figcaption class="mt-2 text-xs text-tekst">Aan de Dijk 126, Herten</figcaption>
    </figure>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-lijn py-5 text-xs text-tekst">
    <p>{site.naam}, {site.plaats}. Rolex is een geregistreerd merk van Rolex SA; Omega, Longines en Rado zijn merken van de Swatch Group.</p>
    <p class="flex gap-5"><a href={url('privacy/')} class="underline">Privacyverklaring</a><a href="https://www.sitefront.nl" rel="noopener" target="_blank" class="underline">Website door Sitefront</a></p>
  </div>
</footer>

<!-- Vaste balk onderaan op mobiel. -->
<div class="fixed inset-x-0 bottom-0 z-30 grid grid-cols-2 gap-2 border-t border-lijn bg-papier/95 p-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] backdrop-blur-sm md:hidden">
  <a href={waAfspraak} class="knop knop-licht !min-h-12 !px-3">WhatsApp</a>
  <a href={h('contact')} class="knop knop-vol !min-h-12 !px-3">Afspraak maken</a>
</div>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  const k = document.querySelector<HTMLAnchorElement>('[data-wa-knop]');
  const m = document.querySelector<HTMLAnchorElement>('[data-mail-knop]');
  if (f && k) {
    const basis = k.href.split('?')[0];
    const mailBasis = m?.href.split('?')[0] ?? '';
    const bouw = () => {
      const d = new FormData(f);
      const r = ['Goedendag, ik wil graag een afspraak maken voor mijn horloge.'];
      const v = (n: string) => String(d.get(n) || '').trim();
      if (v('merk')) r.push('Merk: ' + v('merk'));
      if (v('type')) r.push('Type: ' + v('type'));
      if (v('ref')) r.push('Model of referentienummer: ' + v('ref'));
      if (v('band')) r.push('Band: ' + v('band'));
      if (v('vraag')) r.push('Wat er aan de hand is: ' + v('vraag'));
      if (r.length > 1) r.push('Foto’s stuur ik hierna mee.');
      k.href = basis + '?text=' + encodeURIComponent(r.join('\n'));
      if (m) m.href = mailBasis + '?subject=' + encodeURIComponent('Afspraak voor mijn horloge') + '&body=' + encodeURIComponent(r.join('\n'));
    };
    f.addEventListener('input', bouw);
    f.addEventListener('change', bouw);
    f.addEventListener('submit', (e) => { e.preventDefault(); bouw(); k.click(); });
  }
</script>

<style>
  .veld { display: block; padding-block: .25rem 1.25rem; }
  .veld > span { display: block; font-size: var(--text-sm); color: var(--color-licht-zacht); }
  .veld input, .veld select, .veld textarea { display: block; width: 100%; margin-top: .4rem; padding: .6rem .75rem; background: #14213b; color: var(--color-licht); border: 1px solid #f5f1ea4d; border-radius: 0; font: inherit; transition: border-color .2s; resize: vertical; }
  .veld select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%); background-position: calc(100% - 14px) 55%, calc(100% - 9px) 55%; background-size: 5px 5px; background-repeat: no-repeat; }
  .veld select option { color: #14213b; background: #fff; }
  .veld input::placeholder, .veld textarea::placeholder { color: #f5f1ea80; }
  .veld input:hover, .veld select:hover, .veld textarea:hover { border-color: #f5f1ea8c; }
  .veld input:focus-visible, .veld select:focus-visible, .veld textarea:focus-visible { outline: 2px solid var(--color-messing-licht); outline-offset: 2px; border-color: var(--color-messing-licht); }
</style>
