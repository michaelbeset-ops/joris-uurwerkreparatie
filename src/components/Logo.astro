---
// Logo van Joris Uurwerkreparatie (aangeleverd door Michael, achtergrond transparant gemaakt met tools/logo.mjs).
// Op een donkere achtergrond staat het op een wit vlak: de donkergrijze letters zijn op marine niet leesbaar.
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
interface Props { licht?: boolean; class?: string }
const { licht = false, class: klasse = '' } = Astro.props;
---
{licht ? (
  <span class={`inline-block rounded-lg bg-wit px-4 py-3 ${klasse}`}><Image src={logo} alt="Joris Uurwerkreparatie" widths={[200, 397]} sizes="200px" class="h-14 w-auto" /></span>
) : (
  <Image src={logo} alt="Joris Uurwerkreparatie" widths={[160, 320, 397]} sizes="(min-width: 1024px) 192px, 150px" loading="eager" class={`h-12 w-auto lg:h-16 ${klasse}`} />
)}
