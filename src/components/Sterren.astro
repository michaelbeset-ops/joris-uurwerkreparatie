---
// Vijf sterren voor de Google-score (4,5): vier vol, een half.
interface Props { klein?: boolean }
const { klein = false } = Astro.props;
const m = klein ? 14 : 18;
---
<span class="ster inline-flex gap-0.5" aria-hidden="true">
  {[0, 1, 2, 3].map(() => <svg width={m} height={m} viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4 6.1 20.5l1.2-6.5L2.5 9.4l6.6-.9z"/></svg>)}
  <svg width={m} height={m} viewBox="0 0 24 24"><defs><linearGradient id="half"><stop offset="50%" stop-color="currentColor"/><stop offset="50%" stop-color="transparent"/></linearGradient></defs><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4 6.1 20.5l1.2-6.5L2.5 9.4l6.6-.9z" fill="url(#half)" stroke="currentColor" stroke-width="1.2"/></svg>
</span>
