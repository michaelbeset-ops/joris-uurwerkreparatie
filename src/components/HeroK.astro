---
// Hero K: wit, de klassieke Seamaster groot in zwart-wit, vervagend in het wit, met een grote kop ernaast.
// Desktop (vanaf lg): het horloge groot rechts. Mobiel: het horloge gecentreerd boven de tekst.
import { Image } from 'astro:assets';
import Icoon from './Icoon.astro';
import Sterren from './Sterren.astro';
import { site } from '../data/site';
import heroFoto from '../assets/hero/seamaster-wit.jpg';

interface Props { contact?: string }
const { contact = '#contact' } = Astro.props;
const reviewsUrl = 'https://www.google.com/maps/search/?api=1&query=Joris+Uurwerkreparatie+Herten';
const alt = 'Een klassieke Omega Seamaster-chronograaf in zwart-wit';
---
<section class="relative flex min-h-[calc(100svh-5rem)] flex-col overflow-hidden bg-wit lg:min-h-[calc(100svh-6rem)]" aria-labelledby="t-hero">
  <!-- Desktop: groot rechts, loopt van boven tot onder. -->
  <!-- lazy: op mobiel staat deze verborgen en wordt hij dan niet geladen; op desktop staat hij direct in beeld. -->
  <Image src={heroFoto} alt={alt} widths={[600, 1088]} sizes="50vw" loading="lazy" class="hero-foto pointer-events-none absolute right-[2%] top-[-4%] hidden h-[112%] w-auto object-contain lg:block" />

  <div class="flex justify-center pt-4 lg:hidden">
      <Image src={heroFoto} alt={alt} widths={[600]} sizes="80vw" loading="eager" fetchpriority="high" class="hero-foto h-[36svh] w-auto object-contain" />
  </div>
  <div class="wrap relative mt-auto pb-24 pt-6 md:pb-12 lg:pb-16 lg:pt-16">
    <p class="font-display text-xs font-bold uppercase tracking-[.18em] text-goud-donker sm:text-sm sm:tracking-[.2em]">Officieel Omega Service <span class="whitespace-nowrap">Center · {site.plaats}</span></p>
    <h1 id="t-hero" class="mt-4 max-w-[11ch] text-[clamp(2.8rem,6.4vw+0.8rem,7.25rem)] font-extrabold leading-[.95] tracking-[-0.045em] text-marine">Uw horloge in handen van erkend vakmanschap.</h1>
    <div class="mt-7 flex flex-wrap items-center gap-x-8 gap-y-4 sm:mt-9">
      <a href={contact} class="btn btn-marine">Afspraak maken<Icoon naam="pijl" maat={20} /></a>
      <a href={reviewsUrl} target="_blank" rel="noopener" class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-zacht no-underline hover:underline"><Sterren maat={15} /><strong class="num font-display text-ink">{site.google.score}</strong> op Google<span aria-hidden="true">·</span>Ook Longines, Rado en Rolex<span class="sr-only"> (opent in een nieuw tabblad)</span></a>
    </div>
  </div>

</section>

<style>
  /* Laat de randen van de foto in het wit oplossen, zodat de horlogedoos niet als rechthoek zichtbaar is. */
  .hero-foto { -webkit-mask-image: radial-gradient(closest-side, #000 62%, transparent 100%); mask-image: radial-gradient(closest-side, #000 62%, transparent 100%); }
</style>
