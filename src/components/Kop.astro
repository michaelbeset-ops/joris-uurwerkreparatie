---
// USP-balk met de feiten van hun eigen site en de Google-score, daaronder een zwevende witte navigatiekaart
// die bovenaan blijft plakken. Op de homepage schuift de hero eronder door.
import Icoon from './Icoon.astro';
import Sterren from './Sterren.astro';
import { url, site, waAfspraak } from '../data/site';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const menu = [['Omega', 'omega'], ['Diensten', 'diensten'], ['Werkwijze', 'werkwijze'], ['Over Hugo', 'over'], ['Rolex', 'rolex']];
const usps = ['Officieel Omega Service Center', 'Originele onderdelen', 'Eerst onderzoek, dan een prijs'];
const reviews = 'https://www.google.com/maps/search/?api=1&query=Joris+Uurwerkreparatie+Herten';
---
<div class="relative z-50 bg-wit text-ink">
  <div class="wrap flex h-10 items-center justify-between gap-6 text-xs sm:text-sm">
    <ul class="flex min-w-0 items-center gap-6 overflow-hidden">
      {usps.map((u, i) => <li class={`flex items-center gap-1.5 whitespace-nowrap ${i > 0 ? 'hidden md:flex' : ''}`}><Icoon naam="vink" maat={16} dik={2.6} class="text-vink" /><span>{u}</span></li>)}
    </ul>
    <a href={reviews} target="_blank" rel="noopener" class="flex shrink-0 items-center gap-2 no-underline hover:underline"><Sterren maat={14} /><span><strong class="num font-semibold">{site.google.score}</strong><span class="hidden sm:inline"> op Google</span></span><span class="sr-only"> (opent in een nieuw tabblad)</span></a>
  </div>
</div>
<header class="sticky top-0 z-40 px-3 pt-3 md:px-6">
  <div class="mx-auto flex h-16 max-w-[78rem] items-center justify-between gap-3 rounded-xl bg-wit/95 pl-4 pr-2 shadow-kaart ring-1 ring-lijn backdrop-blur-sm lg:h-[4.5rem] lg:pl-6">
    <a href={url('')} class="flex items-center gap-3 no-underline">
      <span class="flex h-10 w-10 items-center justify-center rounded-md bg-marine text-wit"><Icoon naam="horloge" maat={24} dik={1.7} /></span>
      <span class="font-display leading-none"><span class="block text-[1.25rem] font-extrabold tracking-[-0.02em]">Joris</span> <span class="mt-0.5 block text-[0.8125rem] font-semibold text-ink-zacht">Uurwerkreparatie</span></span>
    </a>
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-1 font-display text-[1rem] font-semibold">
        {menu.map(([n, id]) => <li><a href={h(id)} class="block rounded-md px-3.5 py-2 no-underline transition-colors hover:bg-ijs">{n}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <a href={site.telHref} class="btn btn-wit hidden !min-h-11 !px-4 !text-[0.9375rem] xl:inline-flex"><Icoon naam="telefoon" maat={18} /><span class="num">{site.tel}</span></a>
      <a href={h('contact')} class="btn btn-marine hidden !min-h-11 !px-4 !text-[0.9375rem] sm:inline-flex">Afspraak maken</a>
      <button type="button" class="flex h-11 w-11 items-center justify-center rounded-md ring-1 ring-lijn lg:hidden" aria-expanded="false" aria-controls="menu-mobiel" aria-label="Menu" data-menu-knop>
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" data-open-icoon /><path d="M6 6l12 12M18 6L6 18" class="hidden" data-dicht-icoon /></svg>
      </button>
    </div>
  </div>
  <div class="fixed inset-0 z-[-1] hidden bg-ink/40 lg:!hidden" data-menu-sluier aria-hidden="true"></div>
  <nav id="menu-mobiel" aria-label="Menu" class="mx-auto mt-2 hidden max-h-[calc(100dvh-6rem)] max-w-[78rem] overflow-y-auto rounded-xl bg-wit p-4 shadow-kaart ring-1 ring-lijn lg:!hidden" data-menu>
    <ul class="grid font-display text-lg font-semibold">
      {menu.map(([n, id]) => <li class="border-b border-lijn last:border-0"><a href={h(id)} class="block py-3 no-underline">{n}</a></li>)}
    </ul>
    <div class="mt-4 grid gap-2 sm:grid-cols-2">
      <a href={waAfspraak} class="btn btn-wit w-full"><Icoon naam="bericht" maat={18} />WhatsApp</a>
      <a href={site.telHref} class="btn btn-wit w-full"><Icoon naam="telefoon" maat={18} /><span class="num">{site.tel}</span></a>
    </div>
  </nav>
</header>
<script>
  const knop = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const sluier = document.querySelector<HTMLElement>('[data-menu-sluier]');
  if (knop && menu) {
    const zet = (open: boolean) => {
      menu.classList.toggle('hidden', !open); knop.setAttribute('aria-expanded', String(open));
      sluier?.classList.toggle('hidden', !open);
      knop.querySelector('[data-open-icoon]')?.classList.toggle('hidden', open);
      knop.querySelector('[data-dicht-icoon]')?.classList.toggle('hidden', !open);
      document.body.style.overflow = open ? 'hidden' : '';
    };
    knop.addEventListener('click', () => zet(menu.classList.contains('hidden')));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => zet(false)));
    sluier?.addEventListener('click', () => zet(false));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.classList.contains('hidden')) { zet(false); knop.focus(); } });
  }
</script>
