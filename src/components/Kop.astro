---
// Rustige kopbalk: woordmerk, menu, telefoon en een knop. Plakt bovenaan.
import { url, site, waAfspraak } from '../data/site';
interface Props { thuis?: boolean; overHero?: boolean }
// overHero: de kop ligt transparant over de donkere hero (alleen op de homepage); elders plakt hij bovenaan.
const { thuis = true, overHero = false } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const menu = [['Omega', 'omega'], ['Diensten', 'diensten'], ['Werkwijze', 'werkwijze'], ['Over', 'over'], ['Rolex', 'rolex']];
---
<header data-kop class={overHero ? 'kop-over fixed inset-x-0 top-0 z-40 text-white transition-colors duration-300' : 'sticky top-0 z-40 border-b border-lijn bg-papier/95 backdrop-blur-sm'}>
  <div class="wrap flex h-20 items-center justify-between gap-6">
    <a href={url('')} class="merk"><b>Joris</b><small>Uurwerkreparatie</small></a>
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class={`flex gap-8 text-[1rem] ${overHero ? 'text-white/85' : ''}`}>
        {menu.map(([n, id]) => <li><a href={h(id)} class="lijn-in">{n}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-5">
      <a href={site.telHref} class="num hidden text-[1rem] font-medium xl:inline">{site.tel}</a>
      <a href={h('contact')} class={`knop ${overHero ? 'knop-glas' : 'knop-vol'} hidden !min-h-11 !px-4 !text-[1rem] sm:inline-flex`}>Afspraak maken</a>
      <button type="button" class={`flex h-11 w-11 items-center justify-center border lg:hidden ${overHero ? 'border-white/40' : 'border-lijn-sterk'}`} aria-expanded="false" aria-controls="menu-mobiel" aria-label="Menu" data-menu-knop>
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" data-open-icoon /><path d="M6 6l12 12M18 6L6 18" class="hidden" data-dicht-icoon /></svg>
      </button>
    </div>
  </div>
  <div class="fixed inset-0 top-20 z-[-1] hidden bg-nacht/40 lg:!hidden" data-menu-sluier aria-hidden="true"></div>
  <nav id="menu-mobiel" aria-label="Menu" class="hidden border-y border-lijn bg-papier text-inkt lg:!hidden" data-menu>
    <div class="wrap py-4">
      <ul class="grid text-lg font-medium">
        {menu.map(([n, id]) => <li class="border-b border-lijn last:border-0"><a href={h(id)} class="block py-3">{n}</a></li>)}
      </ul>
      <div class="mt-4 grid gap-2 sm:grid-cols-2">
        <a href={waAfspraak} class="knop knop-licht w-full">WhatsApp</a>
        <a href={site.telHref} class="knop knop-licht num w-full">Bel {site.tel}</a>
      </div>
    </div>
  </nav>
</header>
<script>
  // Kop over de hero: transparant bovenaan, donkere balk zodra de bezoeker scrolt.
  const kop = document.querySelector<HTMLElement>('.kop-over');
  if (kop) { const zet = () => kop.classList.toggle('gescrold', scrollY > 40); zet(); addEventListener('scroll', zet, { passive: true }); }
  const knop = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const sluier = document.querySelector<HTMLElement>('[data-menu-sluier]');
  if (knop && menu) {
    const zet = (open: boolean) => {
      menu.classList.toggle('hidden', !open); knop.setAttribute('aria-expanded', String(open));
      sluier?.classList.toggle('hidden', !open);
      knop.querySelector('[data-open-icoon]')?.classList.toggle('hidden', open);
      knop.querySelector('[data-dicht-icoon]')?.classList.toggle('hidden', !open);
      document.body.style.overflow = open ? 'hidden' : '';
    };
    knop.addEventListener('click', () => zet(menu.classList.contains('hidden')));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => zet(false)));
    sluier?.addEventListener('click', () => zet(false));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.classList.contains('hidden')) { zet(false); knop.focus(); } });
  }
</script>
