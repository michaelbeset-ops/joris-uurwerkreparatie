---
import { url, site } from '../data/site';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
---
<header class="sticky top-0 z-40 border-b border-lijn bg-papier/95 backdrop-blur-sm">
  <div class="wrap grid h-20 grid-cols-[1fr_auto] items-center md:h-24 md:grid-cols-[1fr_auto_1fr]">
    <nav aria-label="Hoofdmenu" class="hidden md:block">
      <ul class="ui flex gap-7 lg:gap-9">
        <li><a href={h('omega')} class="lijn-in">Omega</a></li>
        <li><a href={h('diensten')} class="lijn-in">Diensten</a></li>
        <li><a href={h('werkwijze')} class="lijn-in">Werkwijze</a></li>
        <li><a href={h('over')} class="lijn-in">Over</a></li>
      </ul>
    </nav>
    <a href={url('')} class="merk justify-self-start md:justify-self-center">
      <b>JORIS</b><small>Uurwerkreparatie</small>
    </a>
    <p class="ui flex items-center justify-end gap-7 lg:gap-9">
      <a href={site.telHref} class="lijn-in num hidden lg:inline">{site.tel}</a>
      <a href={h('contact')} class="lijn-in">Afspraak</a>
    </p>
  </div>
</header>
