---
// BASIS prijsindicatie (pakket van 100 euro): merk kiezen, één dienst kiezen, vanaf-prijs met korte uitleg en
// direct contact via WhatsApp of telefoon. Prijzen uit src/data/prijzen.ts; onbekende prijzen tonen "prijs na onderzoek".
import Icoon from './Icoon.astro';
import { merken, onderdelen, rolexServicebeurt, prijstabel } from '../data/prijzen';
import { site } from '../data/site';
const rolexVanaf = Math.min(...rolexServicebeurt.map((r) => r.prijs));
const tabel = prijstabel(merken.map((m) => m.id));
const data = JSON.stringify({ merken, onderdelen, rolexVanaf, tabel, wa: site.wa });
---
<div class="grid grid-cols-1 gap-6 lg:grid-cols-12" data-basis={data}>
  <div class="kaart grid min-w-0 grid-cols-1 content-start gap-6 p-5 [--rand:1.25rem] sm:p-7 sm:[--rand:1.75rem] lg:col-span-8 lg:gap-7">
    <fieldset class="min-w-0">
      <legend class="font-display text-lg font-bold">Welk merk?</legend>
      <div class="rij mt-3 flex gap-2 py-0.5 lg:flex-wrap">
        {merken.map((m, i) => (
          <label class="pil-keuze"><input type="radio" name="b-merk" value={m.id} checked={i === 0} class="sr-only" />{m.naam}</label>
        ))}
      </div>
    </fieldset>
    <fieldset class="min-w-0">
      <legend class="font-display text-lg font-bold">Wat moet er gebeuren?</legend>
      <div class="rij mt-3 gap-2 py-0.5 lg:grid lg:grid-cols-4">
        {onderdelen.map((o, i) => (
          <label class="tegel w-[8.5rem] lg:w-auto"><input type="radio" name="b-dienst" value={o.id} checked={i === 0} class="sr-only" />
            <span class="text-marine"><Icoon naam={o.icoon} maat={26} /></span>
            <span class="mt-2 block font-display text-[0.9375rem] font-bold leading-tight">{o.naam}</span>
          </label>
        ))}
      </div>
    </fieldset>
  </div>

  <div class="donker flex flex-col rounded-2xl bg-marine p-6 text-wit shadow-kaart sm:p-7 lg:col-span-4" aria-live="polite">
    <p class="kicker text-staal">Uw prijsindicatie</p>
    <p class="mt-3 font-display text-cijfer font-extrabold leading-none" data-uitkomst>&nbsp;</p>
    <p class="mt-3 font-display font-bold" data-dienst>&nbsp;</p>
    <p class="mt-1 line-clamp-3 text-sm text-staal lg:line-clamp-none" data-toelichting>&nbsp;</p>
    <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 border-t border-wit/15 pt-4 text-sm lg:grid">
      <li class="flex gap-2"><Icoon naam="vink" maat={16} dik={2.6} class="mt-1 text-vink-licht" />Eerst onderzoek, dan een prijsopgave</li>
      <li class="flex gap-2"><Icoon naam="vink" maat={16} dik={2.6} class="mt-1 text-vink-licht" />Niets zonder uw akkoord</li>
    </ul>
    <div class="mt-auto grid grid-cols-[minmax(0,1fr)_3.25rem] gap-2 pt-6 lg:grid-cols-1">
      <a href={site.wa} class="btn w-full bg-wit text-marine hover:bg-ijs" data-basis-wa><Icoon naam="bericht" maat={20} /><span><span class="max-[389px]:hidden">Vraag </span>prijsopgave</span></a>
      <a href={site.telHref} class="btn btn-glas w-full !px-0 lg:!px-[1.4rem]" aria-label={`Bel ${site.tel}`}><Icoon naam="telefoon" maat={18} /><span class="hidden lg:inline">Bel <span class="num">{site.tel}</span></span></a>
    </div>
  </div>
</div>

<script>
  type Data = { merken: { id: string; naam: string }[]; onderdelen: { id: string; naam: string; toelichting: string; alleenMetServicebeurt?: boolean }[]; rolexVanaf: number; tabel: Record<string, Record<string, { prijs: number | null }>>; wa: string };
  const root = document.querySelector<HTMLElement>('[data-basis]');
  if (root) {
    const d: Data = JSON.parse(root.dataset.basis!);
    const waarde = (n: string) => root.querySelector<HTMLInputElement>(`input[name="${n}"]:checked`)!.value;
    const zet = (sel: string, t: string) => { root.querySelector(sel)!.textContent = t; };
    const bereken = () => {
      const merk = waarde('b-merk');
      const o = d.onderdelen.find((x) => x.id === waarde('b-dienst'))!;
      const p = o.id === 'servicebeurt' && merk === 'rolex' ? d.rolexVanaf : d.tabel[o.id][merk].prijs;
      zet('[data-uitkomst]', typeof p === 'number' ? 'v.a. € ' + p.toLocaleString('nl-NL') : 'Prijs na onderzoek');
      const u = root.querySelector<HTMLElement>('[data-uitkomst]')!; u.classList.toggle('text-cijfer', typeof p === 'number'); u.classList.toggle('text-3xl', typeof p !== 'number');
      zet('[data-dienst]', o.naam + (o.alleenMetServicebeurt ? ' (bij een servicebeurt)' : ''));
      zet('[data-toelichting]', o.toelichting);
      const merkNaam = d.merken.find((m) => m.id === merk)?.naam ?? '';
      const tekst = ['Goedendag, ik wil graag een prijsopgave voor mijn horloge.', 'Merk: ' + merkNaam, 'Wat er moet gebeuren: ' + o.naam, 'Foto’s stuur ik hierna mee.'];
      root.querySelector<HTMLAnchorElement>('[data-basis-wa]')!.href = d.wa + '?text=' + encodeURIComponent(tekst.join('\n'));
    };
    root.addEventListener('change', bereken);
    bereken();
  }
</script>

<style>
  .pil-keuze { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 1rem; border-radius: 999px; cursor: pointer; font-family: var(--font-display); font-weight: 600; font-size: .9375rem; background: #fff; box-shadow: inset 0 0 0 1.5px var(--color-lijn); transition: background-color .15s, color .15s, box-shadow .15s; }
  .pil-keuze:hover { box-shadow: inset 0 0 0 1.5px #0f2a4a66; }
  .pil-keuze:has(input:checked) { background: var(--color-marine); color: #fff; box-shadow: none; }
  .tegel { display: block; cursor: pointer; border-radius: var(--radius-md); padding: .9rem; background: #fff; box-shadow: inset 0 0 0 1.5px var(--color-lijn); transition: box-shadow .15s, background-color .15s; }
  .tegel:hover { box-shadow: inset 0 0 0 1.5px #0f2a4a66; }
  .tegel:has(input:checked) { box-shadow: inset 0 0 0 2px var(--color-marine); background: var(--color-marine-licht); }
  .pil-keuze:has(input:focus-visible), .tegel:has(input:focus-visible) { outline: 3px solid var(--color-marine); outline-offset: 2px; }
</style>
