---
// BASIS prijsindicatie (pakket van 100 euro): merk kiezen, één dienst kiezen, vanaf-prijs zien en via WhatsApp
// een prijsopgave aanvragen. Prijzen uit src/data/prijzen.ts; onbekende prijzen tonen "prijs na onderzoek".
// De uitgebreide versie (meerdere onderdelen, totaal, Rolex-model) staat in CalculatorUitgebreid.astro.
import Icoon from './Icoon.astro';
import { merken, onderdelen, rolexServicebeurt } from '../data/prijzen';
import { site } from '../data/site';
const rolexVanaf = Math.min(...rolexServicebeurt.map((r) => r.prijs));
const data = JSON.stringify({ merken, onderdelen, rolexVanaf, wa: site.wa });
---
<section id="prijzen" class="wrap scroll-mt-28 py-16 lg:py-24" aria-labelledby="t-prijzen">
  <div class="kaart grid gap-8 p-6 sm:p-8 lg:grid-cols-12 lg:items-center lg:gap-10 lg:p-12" data-basis={data}>
    <div class="lg:col-span-5">
      <p class="kicker text-ink-zacht">Prijsindicatie</p>
      <h2 id="t-prijzen" class="mt-3 text-3xl">Wat kost het ongeveer?</h2>
      <p class="mt-4 text-ink-zacht">Kies merk en dienst voor een vanaf-prijs. De definitieve prijs hoort u na onderzoek.</p>
    </div>
    <div class="grid gap-4 lg:col-span-7">
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="b-merk" class="text-sm font-medium">Merk</label>
          <select id="b-merk" class="veld mt-1.5">{merken.map((m) => <option value={m.id}>{m.naam}</option>)}</select>
        </div>
        <div>
          <label for="b-dienst" class="text-sm font-medium">Wat moet er gebeuren?</label>
          <select id="b-dienst" class="veld mt-1.5">{onderdelen.map((o) => <option value={o.id}>{o.naam}</option>)}</select>
        </div>
      </div>
      <div class="flex flex-col gap-4 rounded-xl bg-marine p-5 text-wit sm:flex-row sm:items-center sm:justify-between" aria-live="polite">
        <div>
          <p class="font-display text-2xl font-extrabold leading-tight" data-uitkomst>&nbsp;</p>
          <p class="mt-1 text-sm text-staal" data-noot>&nbsp;</p>
        </div>
        <a href={site.wa} class="btn shrink-0 bg-wit text-marine hover:bg-ijs" data-basis-wa><Icoon naam="bericht" maat={20} />Vraag prijsopgave</a>
      </div>
    </div>
  </div>
</section>

<script>
  type Data = { merken: { id: string; naam: string }[]; onderdelen: { id: string; naam: string; prijs: Record<string, number | null>; alleenMetServicebeurt?: boolean }[]; rolexVanaf: number; wa: string };
  const root = document.querySelector<HTMLElement>('[data-basis]');
  if (root) {
    const d: Data = JSON.parse(root.dataset.basis!);
    const merk = root.querySelector<HTMLSelectElement>('#b-merk')!;
    const dienst = root.querySelector<HTMLSelectElement>('#b-dienst')!;
    const bereken = () => {
      const o = d.onderdelen.find((x) => x.id === dienst.value)!;
      const p = o.id === 'servicebeurt' && merk.value === 'rolex' ? d.rolexVanaf : (o.prijs[merk.value] ?? o.prijs.alle ?? null);
      root.querySelector('[data-uitkomst]')!.textContent = typeof p === 'number' ? 'Vanaf € ' + p.toLocaleString('nl-NL') : 'Prijs na onderzoek';
      root.querySelector('[data-noot]')!.textContent = o.alleenMetServicebeurt ? 'Alleen samen met een servicebeurt.' : typeof p === 'number' ? 'Indicatie. Definitieve prijs na onderzoek.' : 'U krijgt een prijsopgave na onderzoek.';
      const merkNaam = d.merken.find((m) => m.id === merk.value)?.naam ?? '';
      const tekst = ['Goedendag, ik wil graag een prijsopgave voor mijn horloge.', 'Merk: ' + merkNaam, 'Wat er moet gebeuren: ' + o.naam, 'Foto’s stuur ik hierna mee.'];
      root.querySelector<HTMLAnchorElement>('[data-basis-wa]')!.href = d.wa + '?text=' + encodeURIComponent(tekst.join('\n'));
    };
    merk.addEventListener('change', bereken);
    dienst.addEventListener('change', bereken);
    bereken();
  }
</script>
