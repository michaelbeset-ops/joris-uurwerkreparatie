---
// Sectie prijsindicatie. In de preview staat bovenaan een demoschakelaar tussen het basispakket (100 euro) en het
// uitgebreide pakket (249 euro), zodat Michael beide aan de klant kan laten zien. Bij oplevering (site.preview = false)
// verdwijnt de schakelaar en staat alleen het gekozen pakket op de site (site.prijsindicatie).
import Calculator from './Calculator.astro';
import CalculatorUitgebreid from './CalculatorUitgebreid.astro';
import { site } from '../data/site';
const standaard = site.prijsindicatie;
---
<section id="prijzen" class="scroll-mt-28 py-16 lg:py-24" aria-labelledby="t-prijzen">
  <div class="wrap">
    {site.preview && (
      <div class="mb-8 flex flex-wrap items-center gap-3 rounded-xl border border-dashed border-marine/40 bg-wit p-3 text-sm" data-demo>
        <span class="px-1 font-medium text-ink-zacht">Sitefront-demo, alleen in de preview:</span>
        <div class="inline-flex rounded-pill bg-ijs p-1" role="group" aria-label="Kies pakket">
          <button type="button" class="demo-knop" data-pakket="basis">Basis <span class="font-normal opacity-75">€ 100</span></button>
          <button type="button" class="demo-knop" data-pakket="uitgebreid">Uitgebreid <span class="font-normal opacity-75">€ 249</span></button>
        </div>
      </div>
    )}
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="kicker text-ink-zacht">Prijsindicatie</p>
        <h2 id="t-prijzen" class="mt-3 text-3xl">Wat kost het ongeveer?</h2>
      </div>
      <p class="text-ink-zacht lg:col-span-5 lg:pb-1">Kies merk en werkzaamheden voor een vanaf-prijs. De definitieve prijs hoort u na onderzoek: de werkelijke slijtage is pas te zien als het horloge gedemonteerd is.</p>
    </div>
    <div class="mt-10" data-variant="basis" hidden={standaard !== 'basis'}><Calculator /></div>
    {(site.preview || standaard === 'uitgebreid') && <div class="mt-10" data-variant="uitgebreid" hidden={standaard !== 'uitgebreid'}><CalculatorUitgebreid /></div>}
  </div>
</section>

<script>
  const demo = document.querySelector<HTMLElement>('[data-demo]');
  if (demo) {
    const zet = (p: string) => {
      document.querySelectorAll<HTMLElement>('[data-variant]').forEach((v) => { v.hidden = v.dataset.variant !== p; });
      demo.querySelectorAll<HTMLButtonElement>('[data-pakket]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pakket === p)));
      try { localStorage.setItem('joris-demo-pakket', p); } catch {}
    };
    const uitUrl = new URLSearchParams(location.search).get('pakket');
    let start = uitUrl;
    if (!start) { try { start = localStorage.getItem('joris-demo-pakket'); } catch {} }
    zet(start === 'uitgebreid' ? 'uitgebreid' : 'basis');
    demo.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-pakket]'); if (b) zet(b.dataset.pakket!); });
  }
</script>

<style>
  .demo-knop { border-radius: 999px; padding: .5rem 1rem; font-family: var(--font-display); font-weight: 700; color: var(--color-ink-zacht); cursor: pointer; }
  .demo-knop[aria-pressed="true"] { background: var(--color-marine); color: #fff; }
</style>
