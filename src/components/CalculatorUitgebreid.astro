---
// UITGEBREIDE prijsindicatie (pakket van 249 euro). Stappenplan in vier stappen:
// 1 merk, 2 werkzaamheden (noodzakelijk en optioneel, met uitleg en Rolex-model), 3 uw horloge, 4 overzicht.
// Het overzicht gaat naar WhatsApp of e-mail, kan gekopieerd of geprint worden, en keuzes worden onthouden.
// Prijzen uit src/data/prijzen.ts; onbekende prijzen tonen "na onderzoek". Er wordt niets verzonden zonder de bezoeker.
import Icoon from './Icoon.astro';
import { merken, onderdelen, rolexServicebeurt } from '../data/prijzen';
import { site } from '../data/site';
const data = JSON.stringify({ merken, onderdelen, rolexServicebeurt, wa: site.wa, mail: site.mail });
const noodzakelijk = onderdelen.filter((o) => !o.alleenMetServicebeurt);
const optioneel = onderdelen.filter((o) => o.alleenMetServicebeurt);
const stappen = ['Merk', 'Werkzaamheden', 'Uw horloge', 'Overzicht'];
---
<div class="grid gap-6 lg:grid-cols-12" data-plus={data}>
  <div class="kaart min-w-0 lg:col-span-8">
    <!-- Voortgang -->
    <ol class="grid grid-cols-4 border-b border-lijn" aria-label="Stappen">
      {stappen.map((s, i) => (
        <li><button type="button" class="stap-tab" data-naar={i}><span class="stap-nr">{i + 1}</span><span class="hidden sm:inline">{s}</span></button></li>
      ))}
    </ol>

    <div class="p-5 sm:p-7">
      <!-- Stap 1 -->
      <section data-stap="0">
        <h3 class="text-xl">Welk merk heeft uw horloge?</h3>
        <div class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
          {merken.map((m, i) => (
            <label class="keuze"><input type="radio" name="u-merk" value={m.id} checked={i === 0} class="sr-only" />
              <span class="block font-display font-bold">{m.naam}</span><span class="block text-sm text-ink-zacht">{m.uitleg}</span>
            </label>
          ))}
        </div>
      </section>

      <!-- Stap 2 -->
      <section data-stap="1" hidden>
        <h3 class="text-xl">Wat moet er gebeuren?</h3>
        <p class="mt-1 text-sm text-ink-zacht">Meerdere keuzes mogelijk. Twijfelt u? Kies de servicebeurt; na onderzoek hoort u wat nodig is.</p>
        <p class="kicker mt-5 text-ink-zacht">Noodzakelijk werk</p>
        <div class="mt-2 grid gap-2">
          {noodzakelijk.map((o) => (
            <div class="keuze !p-0" data-onderdeel={o.id}>
              <label class="flex cursor-pointer items-start gap-3 p-4">
                <input type="checkbox" name="u-werk" value={o.id} class="mt-1 h-5 w-5 shrink-0 accent-[#0f2a4a]" />
                <span class="text-marine"><Icoon naam={o.icoon} maat={22} /></span>
                <span class="min-w-0 flex-1"><span class="block font-display font-bold leading-tight">{o.naam}</span><span class="block text-sm text-ink-zacht">{o.uitleg}</span></span>
                <span class="num shrink-0 whitespace-nowrap text-sm font-semibold" data-prijs></span>
              </label>
              <details class="border-t border-lijn px-4 py-2 text-sm"><summary class="cursor-pointer font-medium text-marine">Wat houdt dit in?</summary><p class="mt-2 text-ink-zacht">{o.toelichting}</p></details>
              {o.id === 'servicebeurt' && (
                <div class="hidden border-t border-lijn px-4 py-3" data-rolex>
                  <label for="u-rolex" class="text-sm font-medium">Welk Rolex-model?</label>
                  <select id="u-rolex" name="u-rolex" class="veld mt-1.5">{rolexServicebeurt.map((r) => <option value={r.id}>{r.naam} (v.a. € {r.prijs})</option>)}</select>
                </div>
              )}
            </div>
          ))}
        </div>
        <p class="kicker mt-6 text-ink-zacht">Optioneel, cosmetisch</p>
        <div class="mt-2 grid gap-2">
          {optioneel.map((o) => (
            <div class="keuze !p-0" data-onderdeel={o.id}>
              <label class="flex cursor-pointer items-start gap-3 p-4">
                <input type="checkbox" name="u-werk" value={o.id} class="mt-1 h-5 w-5 shrink-0 accent-[#0f2a4a]" />
                <span class="text-marine"><Icoon naam={o.icoon} maat={22} /></span>
                <span class="min-w-0 flex-1"><span class="block font-display font-bold leading-tight">{o.naam}</span><span class="block text-sm text-ink-zacht">{o.uitleg}</span></span>
                <span class="num shrink-0 whitespace-nowrap text-sm font-semibold" data-prijs></span>
              </label>
              <details class="border-t border-lijn px-4 py-2 text-sm"><summary class="cursor-pointer font-medium text-marine">Wat houdt dit in?</summary><p class="mt-2 text-ink-zacht">{o.toelichting}</p></details>
            </div>
          ))}
        </div>
      </section>

      <!-- Stap 3 -->
      <section data-stap="2" hidden>
        <h3 class="text-xl">Vertel iets over uw horloge</h3>
        <p class="mt-1 text-sm text-ink-zacht">Alles is optioneel. Hoe meer u vertelt, hoe sneller u een goede prijsopgave krijgt.</p>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          <div><label for="u-model" class="text-sm font-medium">Model of referentienummer</label><input id="u-model" name="u-model" autocomplete="off" placeholder="Bijvoorbeeld Speedmaster 3861" class="veld mt-1.5" /></div>
          <div><label for="u-type" class="text-sm font-medium">Type uurwerk</label><select id="u-type" name="u-type" class="veld mt-1.5"><option value="">Weet ik niet</option><option>Automaat</option><option>Handopwind</option><option>Quartz</option><option>Chronograaf</option></select></div>
          <div class="sm:col-span-2"><label for="u-klacht" class="text-sm font-medium">Wat merkt u aan het horloge?</label><textarea id="u-klacht" name="u-klacht" rows="3" placeholder="Bijvoorbeeld: loopt achter, blijft stilstaan, vocht onder het glas" class="veld mt-1.5"></textarea></div>
          <div><label for="u-sinds" class="text-sm font-medium">Sinds wanneer?</label><input id="u-sinds" name="u-sinds" autocomplete="off" placeholder="Bijvoorbeeld: een paar weken" class="veld mt-1.5" /></div>
          <div><label for="u-laatste" class="text-sm font-medium">Laatste servicebeurt</label><select id="u-laatste" name="u-laatste" class="veld mt-1.5"><option value="">Weet ik niet</option><option>Minder dan 5 jaar geleden</option><option>5 tot 10 jaar geleden</option><option>Meer dan 10 jaar geleden</option><option>Nog nooit</option></select></div>
          <div><label for="u-contact" class="text-sm font-medium">Liefst contact via</label><select id="u-contact" name="u-contact" class="veld mt-1.5"><option>WhatsApp</option><option>Telefoon</option><option>E-mail</option></select></div>
          <div><label for="u-moment" class="text-sm font-medium">Voorkeur voor een afspraak</label><select id="u-moment" name="u-moment" class="veld mt-1.5"><option value="">Geen voorkeur</option><option>Ochtend</option><option>Middag</option><option>Avond</option></select></div>
        </div>
      </section>

      <!-- Stap 4 -->
      <section data-stap="3" hidden>
        <h3 class="text-xl">Uw overzicht</h3>
        <p class="mt-1 text-sm text-ink-zacht">Controleer uw keuzes en stuur ze naar Hugo. Foto's van de voor- en achterkant voegt u daarna toe.</p>
        <pre class="mt-4 whitespace-pre-wrap rounded-xl bg-ijs p-4 font-body text-sm leading-relaxed text-ink" data-overzicht></pre>
        <div class="mt-5 grid gap-2 sm:grid-cols-2">
          <a href={site.wa} class="btn btn-marine w-full" data-plus-wa><Icoon naam="bericht" maat={20} />Stuur via WhatsApp</a>
          <a href={`mailto:${site.mail}`} class="btn btn-wit w-full" data-plus-mail><Icoon naam="mail" maat={20} />Stuur per e-mail</a>
          <button type="button" class="btn btn-wit w-full" data-kopieer><Icoon naam="doos" maat={20} /><span data-kopieer-tekst>Kopieer overzicht</span></button>
          <button type="button" class="btn btn-wit w-full" data-print><Icoon naam="kalender" maat={20} />Print of bewaar als pdf</button>
        </div>
      </section>

      <div class="mt-7 flex items-center justify-between gap-3 border-t border-lijn pt-5">
        <button type="button" class="btn btn-wit" data-vorige>Vorige</button>
        <p class="num text-sm text-ink-zacht lg:hidden" data-mini></p>
        <button type="button" class="btn btn-marine" data-volgende>Volgende</button>
      </div>
    </div>
  </div>

  <aside class="min-w-0 lg:col-span-4">
    <div class="donker sticky top-28 rounded-2xl bg-marine p-6 text-wit shadow-kaart sm:p-7" aria-live="polite">
      <p class="kicker text-staal">Uw prijsindicatie</p>
      <p class="mt-1 text-sm text-staal" data-merknaam></p>
      <p class="mt-3 font-display font-extrabold leading-none" data-totaal></p>
      <p class="mt-2 text-sm text-staal" data-toelichting></p>
      <ul class="mt-5 grid gap-2 border-t border-wit/15 pt-4 text-sm" data-lijst></ul>
      <p class="mt-5 border-t border-wit/15 pt-4 text-xs text-staal">Indicatie, geen offerte. Elk horloge wordt eerst onderzocht. Aan de prijsopgave zijn onderzoeks- en administratiekosten verbonden; die betaalt u alleen als u de reparatie niet laat uitvoeren.</p>
    </div>
  </aside>
</div>

<script>
  type O = { id: string; naam: string; prijs: Record<string, number | null>; alleenMetServicebeurt?: boolean };
  type Data = { merken: { id: string; naam: string }[]; onderdelen: O[]; rolexServicebeurt: { id: string; naam: string; prijs: number }[]; wa: string; mail: string };
  const root = document.querySelector<HTMLElement>('[data-plus]');
  if (root) {
    const d: Data = JSON.parse(root.dataset.plus!);
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const $$ = <T extends Element = HTMLElement>(s: string) => [...root.querySelectorAll<T>(s)];
    const eur = (n: number) => '€ ' + n.toLocaleString('nl-NL');
    const OPSLAG = 'joris-prijsindicatie';
    let stap = 0;

    // Keuzes onthouden in deze browser (handig als iemand later terugkomt). Werkt het niet, dan gewoon zonder.
    const bewaar = () => { try { const f: Record<string, string | string[]> = {}; $$<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input,select,textarea').forEach((el) => { if (!el.name) return; if (el instanceof HTMLInputElement && el.type === 'checkbox') { f[el.name] = [...((f[el.name] as string[]) ?? []), ...(el.checked ? [el.value] : [])]; } else if (el instanceof HTMLInputElement && el.type === 'radio') { if (el.checked) f[el.name] = el.value; } else f[el.name] = el.value; }); localStorage.setItem(OPSLAG, JSON.stringify(f)); } catch {} };
    const herstel = () => { try { const f = JSON.parse(localStorage.getItem(OPSLAG) ?? 'null'); if (!f) return; $$<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input,select,textarea').forEach((el) => { if (!el.name || !(el.name in f)) return; const v = f[el.name]; if (el instanceof HTMLInputElement && el.type === 'checkbox') el.checked = (v as string[]).includes(el.value); else if (el instanceof HTMLInputElement && el.type === 'radio') el.checked = el.value === v; else el.value = v; }); } catch {} };

    const veld = (n: string) => (root.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`[name="${n}"]`)?.value ?? '').trim();
    const merk = () => root.querySelector<HTMLInputElement>('input[name="u-merk"]:checked')!.value;

    const bereken = () => {
      const m = merk();
      const service = $<HTMLInputElement>('input[value="servicebeurt"]');
      $('[data-rolex]').classList.toggle('hidden', !(m === 'rolex' && service.checked));
      const rolex = d.rolexServicebeurt.find((r) => r.id === veld('u-rolex'));
      let totaal = 0, onbekend = 0; const regels: string[] = []; const tekst: string[] = [];
      for (const o of d.onderdelen) {
        const blok = $(`[data-onderdeel="${o.id}"]`);
        const box = blok.querySelector<HTMLInputElement>('input')!;
        if (o.alleenMetServicebeurt) { box.disabled = !service.checked; if (!service.checked) box.checked = false; blok.classList.toggle('opacity-50', !service.checked); }
        const p = o.id === 'servicebeurt' && m === 'rolex' ? (rolex?.prijs ?? null) : (o.prijs[m] ?? o.prijs.alle ?? null);
        blok.querySelector('[data-prijs]')!.textContent = typeof p === 'number' ? 'v.a. ' + eur(p) : 'na onderzoek';
        if (!box.checked) continue;
        const naam = o.id === 'servicebeurt' && m === 'rolex' && rolex ? `${o.naam} (${rolex.naam})` : o.naam;
        const label = naam + (o.alleenMetServicebeurt ? ' (optioneel)' : '');
        if (typeof p === 'number') { totaal += p; regels.push(`<li class="flex justify-between gap-3"><span>${label}</span><span class="num shrink-0">v.a. ${eur(p)}</span></li>`); tekst.push(`- ${label}: v.a. ${eur(p)}`); }
        else { onbekend++; regels.push(`<li class="flex justify-between gap-3"><span>${label}</span><span class="shrink-0 text-staal">na onderzoek</span></li>`); tekst.push(`- ${label}: prijs na onderzoek`); }
      }
      const merkNaam = d.merken.find((x) => x.id === m)?.naam ?? '';
      $('[data-merknaam]').textContent = merkNaam;
      const t = $('[data-totaal]');
      t.textContent = totaal ? 'v.a. ' + eur(totaal) : tekst.length ? 'Op aanvraag' : 'Kies uw werkzaamheden';
      t.className = 'mt-3 font-display font-extrabold leading-none ' + (totaal ? 'text-cijfer' : 'text-2xl');
      $('[data-toelichting]').textContent = !tekst.length ? 'Uw keuzes verschijnen hier.' : onbekend ? `${onbekend === 1 ? 'Eén onderdeel krijgt' : onbekend + ' onderdelen krijgen'} een prijs na onderzoek.` : 'Definitieve prijs na onderzoek.';
      $('[data-lijst]').innerHTML = regels.join('');
      $('[data-mini]').textContent = totaal ? 'v.a. ' + eur(totaal) : '';

      // Overzicht voor stap 4 en de berichten
      const info = [['Model of referentie', veld('u-model')], ['Type uurwerk', veld('u-type')], ['Wat ik merk', veld('u-klacht')], ['Sinds', veld('u-sinds')], ['Laatste servicebeurt', veld('u-laatste')], ['Contact liefst via', veld('u-contact')], ['Voorkeur afspraak', veld('u-moment')]].filter(([, v]) => v);
      const regelsTekst = [
        'Goedendag, ik wil graag een prijsopgave voor mijn horloge.', '',
        'Merk: ' + merkNaam,
        ...info.map(([k, v]) => `${k}: ${v}`), '',
        'Gewenste werkzaamheden:', ...(tekst.length ? tekst : ['- Nog niet gekozen']),
        ...(totaal ? ['', 'Indicatie op de website: v.a. ' + eur(totaal) + (onbekend ? ' (plus onderdelen na onderzoek)' : '')] : []),
        '', 'Foto’s van de voor- en achterkant stuur ik hierna mee.',
      ].join('\n');
      $('[data-overzicht]').textContent = regelsTekst;
      $<HTMLAnchorElement>('[data-plus-wa]').href = d.wa + '?text=' + encodeURIComponent(regelsTekst);
      $<HTMLAnchorElement>('[data-plus-mail]').href = `mailto:${d.mail}?subject=${encodeURIComponent('Prijsopgave ' + merkNaam)}&body=${encodeURIComponent(regelsTekst)}`;
      bewaar();
    };

    const toon = (n: number) => {
      stap = Math.max(0, Math.min(3, n));
      $$('[data-stap]').forEach((s) => { s.hidden = s.dataset.stap !== String(stap); });
      $$('[data-naar]').forEach((b) => { const i = Number(b.dataset.naar); b.toggleAttribute('data-actief', i === stap); b.toggleAttribute('data-klaar', i < stap); b.setAttribute('aria-current', i === stap ? 'step' : 'false'); });
      $<HTMLButtonElement>('[data-vorige]').style.visibility = stap === 0 ? 'hidden' : 'visible';
      $<HTMLButtonElement>('[data-volgende]').style.display = stap === 3 ? 'none' : '';
    };
    const naarBoven = () => { const top = root.getBoundingClientRect().top + scrollY - 110; if (scrollY > top) scrollTo({ top, behavior: 'smooth' }); };
    $('[data-volgende]').addEventListener('click', () => { toon(stap + 1); naarBoven(); });
    $('[data-vorige]').addEventListener('click', () => { toon(stap - 1); naarBoven(); });
    $$('[data-naar]').forEach((b) => b.addEventListener('click', () => toon(Number(b.dataset.naar))));
    $('[data-kopieer]').addEventListener('click', async () => { try { await navigator.clipboard.writeText($('[data-overzicht]').textContent ?? ''); $('[data-kopieer-tekst]').textContent = 'Gekopieerd'; setTimeout(() => { $('[data-kopieer-tekst]').textContent = 'Kopieer overzicht'; }, 2000); } catch {} });
    $('[data-print]').addEventListener('click', () => { document.body.classList.add('print-overzicht'); window.print(); document.body.classList.remove('print-overzicht'); });
    root.addEventListener('input', bereken);
    root.addEventListener('change', bereken);
    herstel(); bereken(); toon(0);
  }
</script>

<style>
  .keuze { display: block; cursor: pointer; border-radius: var(--radius-md); padding: .9rem 1rem; background: #fff; box-shadow: inset 0 0 0 1.5px var(--color-lijn); transition: box-shadow .15s, background-color .15s; }
  .keuze:hover { box-shadow: inset 0 0 0 1.5px #0f2a4a66; }
  .keuze:has(input:checked) { box-shadow: inset 0 0 0 2px var(--color-marine); background: var(--color-marine-licht); }
  .keuze:has(input:focus-visible) { outline: 3px solid var(--color-marine); outline-offset: 2px; }
  .stap-tab { display: flex; width: 100%; align-items: center; justify-content: center; gap: .5rem; padding: 1rem .5rem; font-family: var(--font-display); font-weight: 700; font-size: .9375rem; color: var(--color-ink-zacht); border-bottom: 3px solid transparent; cursor: pointer; }
  .stap-nr { display: inline-flex; height: 1.75rem; width: 1.75rem; align-items: center; justify-content: center; border-radius: 999px; background: var(--color-ijs); font-size: .8125rem; }
  .stap-tab[data-actief] { color: var(--color-marine); border-bottom-color: var(--color-marine); }
  .stap-tab[data-actief] .stap-nr, .stap-tab[data-klaar] .stap-nr { background: var(--color-marine); color: #fff; }
  @media print {
    :global(body.print-overzicht *) { visibility: hidden; }
    :global(body.print-overzicht [data-overzicht]), :global(body.print-overzicht [data-overzicht] *) { visibility: visible; }
    :global(body.print-overzicht [data-overzicht]) { position: absolute; left: 0; top: 0; width: 100%; }
  }
</style>
