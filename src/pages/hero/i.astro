---
// Hero-proef I, "Horizon": het gouden uurwerk komt als een opkomende zon van onderen in beeld, met de
// minutenring eromheen. Logo in het midden van de menubalk. Bewust gecentreerd: zo presenteren
// horlogemerken een nieuw model.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icoon from '../../components/Icoon.astro';
import Sterren from '../../components/Sterren.astro';
import Ring from '../../components/proef/Ring.astro';
import { site, url } from '../../data/site';
import { menu } from '../../components/proef/menu';
import foto from '../../assets/hero/kaliber-rond.jpg';
import logoWit from '../../assets/logo-wit.png';
const links = menu.slice(0, 3);
const rechts = menu.slice(3);
---
<Base title="Hero I | Joris Uurwerkreparatie" description="Hero-proef I">
  <main id="inhoud">
    <section class="relative flex min-h-svh flex-col overflow-hidden bg-[#0b0c0e] text-wit" aria-labelledby="t-hero">
      <div aria-hidden="true" class="absolute inset-0 bg-[radial-gradient(70%_55%_at_50%_100%,#2a2216_0%,#0b0c0e_70%)]"></div>

      <header class="relative z-10">
        <div class="wrap grid h-20 grid-cols-[1fr_auto_1fr] items-center gap-6 lg:h-24">
          <nav aria-label="Hoofdmenu" class="hidden xl:block">
            <ul class="flex items-center gap-8 font-display text-[0.9375rem] font-medium">
              {links.map((m) => <li><a href={m.href} class="text-wit/70 no-underline hover:text-wit">{m.label}</a></li>)}
            </ul>
          </nav>
          <button type="button" class="flex h-11 w-11 items-center justify-center xl:hidden" aria-label="Menu"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 9h16M4 15h16"/></svg></button>
          <a href={url()} class="justify-self-center"><Image src={logoWit} alt="Joris Uurwerkreparatie" widths={[200, 397]} sizes="190px" loading="eager" class="h-11 w-auto lg:h-14" /></a>
          <div class="flex items-center justify-end gap-8">
            <ul class="hidden items-center gap-8 font-display text-[0.9375rem] font-medium xl:flex">
              {rechts.map((m) => <li><a href={m.href} class="text-wit/70 no-underline hover:text-wit">{m.label}</a></li>)}
            </ul>
            <a href={site.telHref} class="flex h-11 w-11 items-center justify-center xl:hidden" aria-label={`Bel ${site.tel}`}><Icoon naam="telefoon" maat={22} /></a>
          </div>
        </div>
      </header>

      <div class="wrap relative z-10 flex flex-col items-center pt-10 text-center lg:pt-14">
        <p class="font-display text-sm font-semibold uppercase tracking-[.24em] text-goud">Officieel Omega Service Center · Herten</p>
        <h1 id="t-hero" class="mt-5 max-w-[17ch] text-[clamp(2.5rem,4.2vw+1rem,5.25rem)] font-bold leading-[1] tracking-[-0.035em] text-wit">Uw horloge in handen van erkend vakmanschap.</h1>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-x-7 gap-y-4">
          <a href={url('#contact')} class="btn !rounded-pill bg-goud !px-7 text-[#0b0c0e] hover:bg-wit">Afspraak maken</a>
          <a href={url('#prijzen')} class="inline-flex items-center gap-2 font-display font-semibold text-wit/80 no-underline hover:text-wit">Wat kost het?<Icoon naam="pijl" maat={18} /></a>
        </div>
        <p class="mt-6 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-sm text-wit/55"><Sterren maat={15} /><strong class="num font-display text-wit/85">{site.google.score}</strong> op Google<span aria-hidden="true" class="text-goud/70">|</span>Ook Longines, Rado en Rolex</p>
      </div>

      <!-- De horizon: alleen de bovenkant van het rondje is te zien; de onderkant valt buiten de sectie. -->
      <div class="relative left-1/2 mt-auto aspect-[100/54] -translate-x-1/2 w-[min(118vw,44rem)] overflow-hidden pt-1 lg:w-[min(56vw,46rem)]">
       <div class="absolute inset-x-0 top-1 aspect-square">
        <Ring />
        <div class="absolute inset-[6.5%] overflow-hidden rounded-full shadow-[0_0_0_1px_#c9a46a55]">
          <Image src={foto} alt="Een geopend goudkleurig chronograafuurwerk met robijnen, op de werkbank van Hugo Joris" widths={[480, 680]} sizes="(min-width: 1024px) 46rem, 100vw" loading="eager" fetchpriority="high" class="h-full w-full scale-[1.06] object-cover object-[48%_46%]" />
        </div>
       </div>
      </div>
    </section>
  </main>
</Base>
