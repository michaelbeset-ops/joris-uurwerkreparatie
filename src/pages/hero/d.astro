---
// Hero-variant D, "Triptiek": warm wit, kop links en tekst met knoppen rechts, daaronder drie zwart-witfoto's naast
// elkaar tot de rand. Elk paneel is 720x900 en staat op 1440 breed op ongeveer 480 breed, dus scherp. Albert Sans.
import '@fontsource-variable/albert-sans';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Sterren from '../../components/Sterren.astro';
import { site, url, waAfspraak } from '../../data/site';
import f1 from '../../assets/hero/d-321.jpg';
import f2 from '../../assets/hero/d-seamaster.jpg';
import f3 from '../../assets/hero/d-groen.jpg';
const panelen = [
  { src: f1, alt: 'Omega-chronograafuurwerk kaliber 321 in een houder', bij: 'Omega kaliber 321' },
  { src: f2, alt: 'Een klassieke Omega Seamaster-chronograaf in een horlogedoos', bij: 'Seamaster chronograaf' },
  { src: f3, alt: 'Een geopend chronograafuurwerk in een houder op de werkbank', bij: 'Servicebeurt' },
];
---
<Base title="Hero D, Triptiek | Joris Uurwerkreparatie" description="Ontwerpvariant hero D">
  <main id="inhoud" class="hero-d flex min-h-svh flex-col bg-[#f6f4ef] text-[#16171a]">
    <header class="wrap flex h-[4.5rem] items-center justify-between gap-6">
      <a href={url('')} class="whitespace-nowrap text-[1.25rem] tracking-[-0.02em]"><span class="font-bold">Joris</span> Uurwerkreparatie</a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block"><ul class="flex gap-8 text-[1rem]">{['Omega', 'Diensten', 'Werkwijze', 'Over'].map((n) => <li><a href="#" class="hover:underline">{n}</a></li>)}</ul></nav>
      <a href={site.telHref} class="num text-[1rem] font-semibold">{site.tel}</a>
    </header>

    <div class="wrap grid gap-8 pb-10 pt-8 lg:grid-cols-12 lg:items-end lg:gap-8 lg:pb-12 lg:pt-12">
      <h1 class="text-[clamp(2.5rem,4.8vw,5rem)] font-bold leading-[1] tracking-[-0.035em] lg:col-span-7">Officieel Omega Service Center in Herten.</h1>
      <div class="lg:col-span-5 lg:pb-2">
        <p class="text-[1.125rem] leading-relaxed text-[#43464d]">Onderhoud en reparatie van Omega, Longines en Rado, met originele onderdelen. Ook voor Rolex en andere Zwitserse merken. Alleen op afspraak.</p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a href="#" class="inline-flex h-12 items-center bg-[#16171a] px-5 text-[1.0625rem] font-semibold text-white hover:bg-[#33353b]">Afspraak maken</a>
          <a href={waAfspraak} class="inline-flex h-12 items-center border border-[#16171a] px-5 text-[1.0625rem] font-semibold hover:bg-[#16171a] hover:text-white">WhatsApp</a>
          <a href="#" class="ml-1 inline-flex items-center gap-2 text-[1rem] text-[#43464d] hover:underline"><Sterren klein /> {site.google.score} op Google</a>
        </div>
      </div>
    </div>

    <ul class="grid flex-1 grid-cols-3 gap-1 lg:gap-1.5">
      {panelen.map((p, i) => (
        <li class="relative min-h-[11rem] overflow-hidden bg-[#dcd9d2]">
          <Image src={p.src} alt={p.alt} widths={[360, 720]} sizes="34vw" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} class="h-full w-full object-cover lg:absolute lg:inset-0" />
          <span class="absolute bottom-3 left-3 hidden bg-[#f6f4ef] px-2.5 py-1 text-[0.875rem] sm:block">{p.bij}</span>
        </li>
      ))}
    </ul>
  </main>
</Base>
<style is:global>
  .hero-d, .hero-d h1 { font-family: "Albert Sans Variable", system-ui, sans-serif; }
</style>
