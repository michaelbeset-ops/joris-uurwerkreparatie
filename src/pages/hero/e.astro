---
// Hero-proef E, "Kijkglas": bijna zwart, het gouden uurwerk groot in een rond venster, zoals door een
// glazen achterkant gezien. Eromheen een getekende minutenring die heel langzaam draait (het enige dat beweegt).
// De foto wordt nergens groter getoond dan de bron (680px), daardoor blijft hij scherp.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icoon from '../../components/Icoon.astro';
import Sterren from '../../components/Sterren.astro';
import { site, url } from '../../data/site';
import { menu } from '../../components/proef/menu';
import foto from '../../assets/hero/kaliber-rond.jpg';
import logoWit from '../../assets/logo-wit.png';

// Minutenring: 60 streepjes, elke vijfde langer en in goud.
const streepjes = Array.from({ length: 60 }, (_, i) => i);
---
<Base title="Hero E | Joris Uurwerkreparatie" description="Hero-proef E">
  <main id="inhoud">
    <section class="relative flex min-h-svh flex-col overflow-hidden bg-[#0b0c0e] text-wit" aria-labelledby="t-hero">
      <div aria-hidden="true" class="absolute inset-0 bg-[radial-gradient(60%_70%_at_72%_52%,#1d2633_0%,#0b0c0e_70%)]"></div>

      <header class="relative z-10">
        <div class="wrap flex h-20 items-center justify-between gap-6 lg:h-24">
          <a href={url()}><Image src={logoWit} alt="Joris Uurwerkreparatie" widths={[200, 397]} sizes="180px" loading="eager" class="h-11 w-auto lg:h-14" /></a>
          <nav aria-label="Hoofdmenu" class="hidden xl:block">
            <ul class="flex items-center gap-9 font-display text-[0.9375rem] font-medium tracking-[.02em]">
              {menu.map((m) => <li><a href={m.href} class="text-wit/70 no-underline transition-colors hover:text-wit">{m.label}</a></li>)}
            </ul>
          </nav>
          <div class="flex items-center gap-4">
            <a href={site.telHref} class="num hidden font-display font-semibold text-wit/80 no-underline hover:text-wit md:block">{site.tel}</a>
            <a href={url('#contact')} class="btn hidden !min-h-11 !rounded-pill border border-goud/70 !px-5 text-goud hover:bg-goud hover:text-[#0b0c0e] sm:inline-flex">Afspraak maken</a>
            <button type="button" class="flex h-11 w-11 items-center justify-center xl:hidden" aria-label="Menu"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 9h16M8 15h12"/></svg></button>
          </div>
        </div>
      </header>

      <div class="wrap relative grid flex-1 items-center gap-6 pb-12 lg:grid-cols-12 lg:gap-8 lg:pb-16">
        <!-- Het venster: eerst in de DOM na de tekst, op mobiel bovenaan via order. -->
        <div class="relative order-1 mx-auto aspect-square w-[min(78vw,26rem)] lg:order-2 lg:col-span-6 lg:col-start-7 lg:w-[min(42vw,36rem)]">
          <svg viewBox="0 0 200 200" aria-hidden="true" class="ring-draait absolute inset-0 h-full w-full">
            <circle cx="100" cy="100" r="99" fill="none" stroke="#c9a46a" stroke-opacity=".35" stroke-width=".4" />
            {streepjes.map((i) => <line x1="100" y1="2.5" x2="100" y2={i % 5 === 0 ? 9 : 5.5} stroke={i % 5 === 0 ? '#c9a46a' : '#ffffff'} stroke-opacity={i % 5 === 0 ? 1 : .35} stroke-width={i % 5 === 0 ? 1 : .5} transform={`rotate(${i * 6} 100 100)`} />)}
          </svg>
          <div class="absolute inset-[7.5%] overflow-hidden rounded-full shadow-[0_0_0_1px_#c9a46a55,0_40px_80px_-20px_#000]">
            <Image src={foto} alt="Een geopend goudkleurig chronograafuurwerk met robijnen, op de werkbank van Hugo Joris" widths={[400, 680]} sizes="(min-width: 1024px) 36rem, 78vw" loading="eager" fetchpriority="high" class="h-full w-full scale-[1.06] object-cover object-[48%_46%]" />
            <div aria-hidden="true" class="absolute inset-0 rounded-full bg-[radial-gradient(circle_at_35%_28%,#ffffff1f_0%,#ffffff00_40%),radial-gradient(circle,#00000000_60%,#0000008c_100%)]"></div>
          </div>
        </div>

        <div class="order-2 lg:order-1 lg:col-span-6">
          <p class="font-display text-sm font-semibold uppercase tracking-[.22em] text-goud">Officieel Omega Service Center</p>
          <h1 id="t-hero" class="mt-5 max-w-[12ch] text-[clamp(2.6rem,4.4vw+1rem,5.5rem)] font-semibold leading-[1] tracking-[-0.035em] text-wit">Uw horloge in handen van erkend vakmanschap.</h1>
          <p class="mt-6 max-w-md text-lg text-wit/65">Onderhoud en reparatie door horlogemaker Hugo Joris in Herten. Met originele onderdelen, alleen op afspraak.</p>
          <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a href={url('#contact')} class="btn !rounded-pill bg-goud !px-7 text-[#0b0c0e] hover:bg-wit">Afspraak maken</a>
            <a href={url('#prijzen')} class="inline-flex items-center gap-2 font-display font-semibold text-wit/80 no-underline hover:text-wit">Wat kost het?<Icoon naam="pijl" maat={18} /></a>
          </div>
          <p class="mt-12 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-wit/55"><Sterren maat={15} /><strong class="num font-display text-wit/85">{site.google.score}</strong> op Google<span aria-hidden="true" class="text-goud/70">|</span>Ook Longines, Rado en Rolex</p>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .ring-draait { animation: draai 120s linear infinite; }
  @keyframes draai { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .ring-draait { animation: none; } }
</style>
