---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Sterren from '../components/Sterren.astro';
import { site, waAfspraak } from '../data/site';
import kaliber from '../assets/kaliber-321.jpg';
import houder from '../assets/omega-houder.jpg';
import groen from '../assets/uurwerk-groen.jpg';
import seamaster from '../assets/seamaster.jpg';
import onderdelen from '../assets/onderdelen.jpg';

// Alle feiten komen van jorisuurwerkreparatie.nl (bron/site-tekst.txt) of het Google-profiel.
// Wat daar niet staat, is gemarkeerd met [[AANLEVEREN]].

const merkenRij = ['Omega', 'Longines', 'Rado', 'Hamilton', 'Mido', 'Tissot', 'Certina', 'ETA-uurwerken', 'Ebel', 'Nomos', 'Mühle Glashütte', 'Rolex'];

// Omega: van de Omega-servicepagina op hun site.
const omegaPunten = [
  'Uitsluitend originele Omega-onderdelen, voor kwaliteit en behoud van waarde',
  'Alle Omega-modellen: Speedmaster, Seamaster, Constellation en De Ville',
  'Ook kalibers 321, 861, 1861 en 3861 van de Speedmaster Professional',
  'Verkoop van originele Omega-horlogebanden',
];
const omegaModellen = [
  ['Speedmaster Professional', 'Moonwatch, kalibers 1861, 861, 321 en 3861'],
  ['Seamaster', 'Diver 300M, Planet Ocean, Aqua Terra, Railmaster'],
  ['Constellation', 'Globemaster'],
  ['De Ville', 'Prestige'],
];

// Diensten: samengevat uit de servicepagina's voor Omega, Longines en Rado.
const diensten = [
  { kop: 'Onderhoud en revisie', tekst: 'Een complete servicebeurt: inspectie, schoonmaken, smeren en afstellen, en waar nodig onderdelen vervangen.', foto: groen, alt: 'Een geopend chronograafuurwerk in een houder op een groene werkmat' },
  { kop: 'Reparaties', tekst: 'Van het vervangen van een kroon of wijzer tot complexe uurwerkreparaties.', foto: onderdelen, alt: 'Losse onderdelen van een gedemonteerd Omega-horloge op de werkbank' },
  { kop: 'Polijsten en cosmetisch herstel', tekst: 'Kast en band herstellen en polijsten, van staal tot keramiek, met behoud van de originele uitstraling.', foto: seamaster, alt: 'Een klassieke Omega Seamaster-chronograaf in een horlogedoos' },
  { kop: 'Waterdichtheid', tekst: 'Controle en herstel van de waterdichtheid, essentieel voor sportieve en duikmodellen.', icoon: 'M12 3c-3 4-6 7.5-6 11a6 6 0 0 0 12 0c0-3.5-3-7-6-11z' },
  { kop: 'Originele onderdelen', tekst: 'Uitsluitend originele onderdelen van het merk, voor kwaliteit en behoud van waarde.', icoon: 'M12 3l8 4.5v9L12 21l-8-4.5v-9zM12 12l8-4.5M12 12v9M12 12L4 7.5' },
];

const merken = [
  { kop: 'Officieel servicecenter', tekst: 'Omega, Longines en Rado' },
  { kop: 'Servicecentrum binnen de Swatch Group', tekst: 'Hamilton, Mido, Tissot, Certina en ETA-uurwerken' },
  { kop: 'Reparatie met originele onderdelen', tekst: 'Ebel, Nomos en Mühle Glashütte' },
];

// Werkwijze: afspraakpagina en "Onze werkwijze" op hun over-ons-pagina.
const stappen = [
  { kop: 'Afspraak maken', tekst: 'Stuur een bericht met merk, type, soort band, eventueel het referentienummer, wat er aan de hand is en een paar foto’s.', icoon: 'M4 5h16v14H4zM4 9h16M8 3v4M16 3v4' },
  { kop: 'Onderzoek en prijsopgave', tekst: 'Elk horloge wordt eerst zorgvuldig onderzocht voordat u een prijsopgave krijgt. Zo weet u precies waar u aan toe bent.', icoon: 'M10 4a6 6 0 1 0 0 12 6 6 0 0 0 0-12zM14.5 14.5L20 20' },
  { kop: 'Herstel', tekst: 'Gaat u akkoord met de prijsopgave, dan ga ik aan de slag met uw horloge.', icoon: 'M14.5 4.5a4 4 0 0 0-5 5L3 16v5h5l6.5-6.5a4 4 0 0 0 5-5l-2.5 2.5-2-2 2.5-2.5z' },
  { kop: 'Ophalen', tekst: 'Is het werk klaar, dan haalt u uw horloge op afspraak weer op. Ziet u af van de reparatie, dan plannen we ook een afspraak om het op te halen.', icoon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 7v5l3 2' },
];

// Vertrouwen: niets hiervan staat op de huidige site. Pas invullen na bevestiging van Hugo.
const zekerheden = [
  { kop: 'Garantie', tekst: '[[AANLEVEREN: garantie op een servicebeurt]]' },
  { kop: 'Doorlooptijd', tekst: '[[AANLEVEREN: gemiddelde doorlooptijd]]' },
  { kop: 'Verzekerd', tekst: '[[AANLEVEREN: verzekerd tijdens reparatie, ja of nee]]' },
  { kop: 'Opsturen', tekst: '[[AANLEVEREN: horloge opsturen mogelijk, ja of nee]]' },
];

// Rolex: prijzen letterlijk van de Rolex-pagina op hun site.
const rolex = [
  ['Modellen tot 30 jaar', '425'],
  ['Damesmodellen', '450'],
  ['Modellen met GMT-kaliber', '475'],
  ['Modellen van 30 jaar en ouder', '525'],
];
const reviewsUrl = 'https://www.google.com/maps/search/?api=1&query=Joris+Uurwerkreparatie+Herten';
---
<Base title={`${site.naam} | Officieel Omega Service Center in Herten`} description="Officieel Omega Service Center en servicecenter voor Longines en Rado in Herten. Onderhoud en reparatie met originele onderdelen, alleen op afspraak.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero, schermvullend. Inktblauw vlak met de foto van het kaliber 321 over de volle hoogte rechts;
         de foto loopt naar links over in het blauw. De foto is 720 x 900 en wordt nergens breder getoond dan
         ongeveer die maat, zodat hij scherp blijft. Op mobiel ligt de foto achter de tekst. -->
    <section class="donker relative isolate -mt-[5rem] flex min-h-[calc(100svh-2.25rem)] flex-col overflow-hidden bg-nacht text-licht lg:-mt-[5.75rem]" aria-labelledby="t-hero">
      <div class="absolute inset-0 -z-10 lg:left-auto lg:w-[min(52vw,48rem)]">
        <Image src={kaliber} alt="Een opengewerkt Omega-chronograafuurwerk, kaliber 321, in een uurwerkhouder op de werkbank" widths={[480, 720]} sizes="(min-width: 1024px) 52vw, 100vw" loading="eager" fetchpriority="high" quality={82} class="h-full w-full object-cover object-[50%_15%] lg:object-[55%_45%]" />
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-nacht from-35% via-nacht/70 via-60% to-nacht/10 lg:bg-gradient-to-r lg:from-nacht lg:from-0% lg:via-nacht/35 lg:via-40% lg:to-transparent"></div>
        <div aria-hidden="true" class="absolute inset-x-0 bottom-0 hidden h-40 bg-gradient-to-t from-nacht to-transparent lg:block"></div>
      </div>

      <div class="wrap relative flex flex-1 flex-col justify-end pb-10 pt-32 lg:justify-center lg:pb-12 lg:pt-36">
        <div class="max-w-[40rem]">
          <p class="ui text-messing-licht">Horlogemaker in Herten<span class="hidden sm:inline">, alleen op afspraak</span></p>
          <h1 id="t-hero" class="mt-5 text-licht">Officieel Omega Service Center in Herten.</h1>
          <p class="mt-6 max-w-[32rem] text-lg text-licht-zacht">Onderhoud en reparatie van Omega, Longines en Rado met originele onderdelen. Ook voor Rolex en andere Zwitserse merken.</p>
          <div class="mt-9 flex flex-wrap items-center gap-3">
            <a href="#contact" class="knop knop-vol">Afspraak maken</a>
            <a href={waAfspraak} class="knop knop-glas">WhatsApp</a>
          </div>
          <p class="mt-5 flex flex-wrap gap-x-6 gap-y-1 text-sm text-licht-zacht">
            <a href={site.telHref} class="num underline decoration-licht/40 underline-offset-4 hover:decoration-licht">Bel<span class="hidden sm:inline"> {site.tel}</span></a>
            <a href={`mailto:${site.mail}`} class="underline decoration-licht/40 underline-offset-4 hover:decoration-licht"><span class="sm:hidden">Mail</span><span class="hidden sm:inline">{site.mail}</span></a>
          </p>
        </div>
      </div>

      <div class="wrap relative pb-20 md:pb-6 lg:pb-8">
        <ul class="grid gap-4 border-t border-lijn-licht pt-6 sm:grid-cols-3 lg:max-w-[52rem]" aria-label="Waarom u hier terecht kunt">
          {[
            ['Officieel', 'Omega Service Center'],
            ['Servicecenter', 'Longines en Rado'],
            [`${site.google.score} op Google`, `uit ${site.google.aantal} beoordelingen`],
          ].map(([a, b], i) => (
            <li class="flex gap-3">
              {i === 2 ? <span class="mt-1"><Sterren klein /></span> : <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-messing-licht"><path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6zM9 12l2 2 4-4" /></svg>}
              <span class="text-sm leading-snug">{i === 2 ? <a href={reviewsUrl} target="_blank" rel="noopener" class="hover:underline"><strong class="block font-medium text-licht">{a}</strong><span class="text-licht-zacht">{b}</span><span class="sr-only"> (opent in een nieuw tabblad)</span></a> : <><strong class="block font-medium text-licht">{a}</strong><span class="text-licht-zacht">{b}</span></>}</span>
            </li>
          ))}
        </ul>
        <p class="absolute bottom-8 right-10 hidden text-xs text-licht-zacht xl:block">Omega kaliber 321, uit de werkplaats</p>
      </div>
    </section>

    <!-- Merkenrij -->
    <nav aria-label="Merken" class="border-y border-lijn bg-papier">
      <ul class="slider wrap py-4 lg:justify-between">
        {merkenRij.map((m) => <li><a href={m === 'Rolex' ? '#rolex' : m === 'Omega' ? '#omega' : '#diensten'} class={`pil ${m === 'Omega' ? 'pil-vol' : ''}`}>{m}</a></li>)}
      </ul>
    </nav>

    <!-- 2. Omega Service Center, donker blok -->
    <section id="omega" class="donker scroll-mt-24 bg-nacht text-licht" aria-labelledby="t-omega">
      <div class="wrap grid gap-10 py-16 lg:grid-cols-12 lg:items-center lg:gap-8 lg:py-24">
        <div class="lg:col-span-6">
          <p class="ui text-messing-licht">Omega Service Center</p>
          <h2 id="t-omega" class="mt-4">Wat een officieel Omega Service Center voor u betekent.</h2>
          <p class="mt-5 max-w-lg text-licht-zacht">Uw Omega wordt onderhouden door een werkplaats die Omega zelf erkent. Dat betekent originele onderdelen en vakmanschap op het niveau dat het merk vraagt.</p>
          <ul class="mt-7 grid gap-3">
            {omegaPunten.map((t) => (
              <li class="flex items-start gap-3"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-messing-licht"><path d="M4 12.5l5 5L20 6.5"/></svg><span>{t}</span></li>
            ))}
          </ul>
          <p class="mt-6 max-w-lg text-sm text-licht-zacht">[[AANLEVEREN: sinds wanneer de erkenning geldt en wat die inhoudt, bijvoorbeeld opleiding bij Omega, werken volgens de Omega-voorschriften, garantie]]</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#contact" class="knop knop-vol">Afspraak voor uw Omega</a>
            <a href="#diensten" class="knop knop-glas">Alle diensten</a>
          </div>
        </div>
        <div class="grid gap-4 lg:col-span-6">
          <figure class="kaart overflow-hidden">
            <Image src={houder} alt="Een Omega-uurwerk in een rode Omega-uurwerkhouder, met een Omega-pincet ernaast" widths={[640, 960, 1150]} sizes="(min-width: 1024px) 40vw, 100vw" class="aspect-[8/5] w-full object-cover" />
          </figure>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="aanleveren aspect-[3/2] w-full">[[AANLEVEREN: foto van het Omega-certificaat of het Service Center-bordje, liggend]]</div>
            <dl class="kaart grid content-start gap-2 p-5 text-sm">
              <dt class="ui text-licht-zacht">Modellen</dt>
              {omegaModellen.map(([m, s]) => <dd><strong class="font-medium">{m}</strong> <span class="text-licht-zacht">{s}</span></dd>)}
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="scroll-mt-24 py-16 lg:py-24" aria-labelledby="t-diensten">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="ui text-messing">Diensten</p>
            <h2 id="t-diensten" class="mt-4">Onderhoud en reparatie, met originele onderdelen.</h2>
          </div>
          <p class="text-tekst lg:col-span-5 lg:pb-1">Voor Omega, Longines, Rado en de andere merken hieronder. Geen modemerken, geen batterijservice en zeker geen imitaties.</p>
        </div>
        <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {diensten.map((d, i) => (
            <li class="kaart flex flex-col">
              {d.foto ? (
                <div class="vervaag"><Image src={d.foto} alt={d.alt} widths={[480, 720, 960]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw" class="aspect-[3/2] w-full object-cover" /></div>
              ) : (
                <div class="flex h-36 items-center justify-center bg-vlak text-inkt"><svg aria-hidden="true" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d={d.icoon}/></svg></div>
              )}
              <div class="flex flex-1 flex-col p-6">
                <span class="num text-sm text-messing">0{i + 1}</span>
                <h3 class="mt-2">{d.kop}</h3>
                <p class="mt-2 text-sm text-tekst">{d.tekst}</p>
                <a href="#contact" class="mt-auto inline-flex items-center gap-2 pt-5 text-sm font-medium no-underline hover:underline">Afspraak maken <span aria-hidden="true">&rarr;</span></a>
              </div>
            </li>
          ))}
          <li class="kaart bg-vlak p-6">
            <p class="ui text-messing">Merken</p>
            <dl class="mt-4 grid gap-4">
              {merken.map((m) => <div><dt class="text-sm text-tekst">{m.kop}</dt><dd class="kop-serif text-k3 leading-tight">{m.tekst}</dd></div>)}
              <div><dt class="text-sm text-tekst">Ook</dt><dd class="kop-serif text-k3 leading-tight"><a href="#rolex" class="underline">Rolex, zie de servicebeurt</a></dd></div>
            </dl>
          </li>
        </ul>
      </div>
    </section>

    <!-- 4. Werkwijze -->
    <section id="werkwijze" class="scroll-mt-24 bg-vlak py-16 lg:py-24" aria-labelledby="t-werkwijze">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="ui text-messing">Werkwijze</p>
            <h2 id="t-werkwijze" class="mt-4">Eerst onderzoek, dan pas een prijs.</h2>
          </div>
          <p class="text-tekst lg:col-span-5 lg:pb-1">Aan de prijsopgave zijn onderzoeks- en administratiekosten verbonden. Die betaalt u alleen als u de reparatie niet laat uitvoeren.</p>
        </div>
        <ol class="relative mt-12 grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-6">
          {stappen.map((s, i) => (
            <li class="relative flex gap-5 lg:block">
              {i < stappen.length - 1 && <span aria-hidden="true" class="absolute left-8 top-16 h-[calc(100%-1.5rem)] w-px bg-lijn-sterk md:hidden lg:left-[4.5rem] lg:top-8 lg:block lg:h-px lg:w-[calc(100%-4.5rem+1.5rem)]"></span>}
              <div class="kaart relative flex h-16 w-16 shrink-0 items-center justify-center text-inkt">
                <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={s.icoon}/></svg>
                <span class="num absolute -right-2 -top-2 flex h-6 w-6 items-center justify-center bg-inkt text-xs font-medium text-papier">{i + 1}</span>
              </div>
              <div class="lg:mt-6">
                <h3><span class="sr-only">Stap {i + 1}: </span>{s.kop}</h3>
                <p class="mt-2 text-sm text-tekst">{s.tekst}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 5. Over Hugo -->
    <section id="over" class="scroll-mt-24 py-16 lg:py-24" aria-labelledby="t-over">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-5">
          <div class="aanleveren aspect-[4/5] w-full">[[AANLEVEREN: portret van Hugo aan de werkbank, staand formaat]]</div>
        </div>
        <div class="lg:col-span-7 lg:pl-6">
          <p class="ui text-messing">Over</p>
          <h2 id="t-over" class="mt-4">Hugo Joris, horlogemaker.</h2>
          <p class="mt-5 max-w-xl text-tekst">Als officieel Omega Service Center ben ik trots op het vertrouwen dat Omega en veel horlogeliefhebbers in mij stellen. Elk horloge krijgt de aandacht die het verdient, met originele onderdelen.</p>
          <p class="mt-4 max-w-xl text-tekst">[[AANLEVEREN: opleiding, aantal jaren ervaring en sinds wanneer de werkplaats Omega-erkend is]]</p>
          <div class="kaart mt-8 grid gap-5 p-6 sm:grid-cols-[auto_1fr] sm:items-center">
            <div>
              <p class="kop-serif num text-cijfer leading-none">{site.google.score}</p>
              <Sterren />
            </div>
            <div class="text-sm">
              <p><strong class="font-medium">{site.google.aantal} beoordelingen op Google.</strong> Klanten noemen een gepassioneerde uurwerkhersteller met gedegen kennis, en zijn zeer tevreden over onder meer de service van een Longines en een klassieke Rolex.</p>
              <a href={reviewsUrl} target="_blank" rel="noopener" class="mt-2 inline-block underline">Lees de beoordelingen op Google<span class="sr-only"> (opent in een nieuw tabblad)</span></a>
            </div>
          </div>
          <dl class="mt-6 grid gap-x-6 gap-y-4 sm:grid-cols-2">
            <div class="border-t border-lijn pt-4"><dt class="text-sm text-tekst">Werkgebied</dt><dd class="mt-1 font-medium">Limburg, Brabant, België en Duitsland</dd></div>
            <div class="border-t border-lijn pt-4"><dt class="text-sm text-tekst">Werkplaats</dt><dd class="mt-1 font-medium">{site.straat}, {site.plaats}. Alleen op afspraak.</dd></div>
            {zekerheden.map((z) => <div class="border-t border-lijn pt-4"><dt class="text-sm text-tekst">{z.kop}</dt><dd class="mt-1 text-sm text-tekst">{z.tekst}</dd></div>)}
          </dl>
        </div>
      </div>
    </section>

    <!-- 6. Rolex, compact -->
    <section id="rolex" class="scroll-mt-24 border-t border-lijn py-16 lg:py-20" aria-labelledby="t-rolex">
      <div class="wrap grid gap-8 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-5">
          <p class="ui text-messing">Ook</p>
          <h2 id="t-rolex" class="mt-4">Rolex-servicebeurt.</h2>
          <p class="mt-5 max-w-md text-tekst">Submariner, Datejust, Day-Date, Air-King, GMT-Master, Explorer, Oyster Perpetual of Super Precision. Vaste prijzen, eerst onderzoek.</p>
          <a href="#contact" class="knop knop-vol mt-6">Afspraak maken</a>
        </div>
        <div class="kaart min-w-0 p-5 sm:p-6 lg:col-span-7">
          <table class="w-full text-left">
            <caption class="sr-only">Prijzen Rolex-servicebeurt</caption>
            <thead class="sr-only"><tr><th scope="col">Model</th><th scope="col">Vanaf</th></tr></thead>
            <tbody>
              {rolex.map(([m, p]) => (
                <tr class="border-b border-lijn">
                  <th scope="row" class="py-3 pr-6 font-normal">{m}</th>
                  <td class="num py-3 text-right font-medium sm:whitespace-nowrap">vanaf € {p},-</td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="mt-4 space-y-2 text-sm text-tekst">
            <p>GMT-modellen van 30 jaar en ouder: <span class="num whitespace-nowrap">€ 50,-</span> extra. Inclusief opwindveer, achterdekseldichting, kroon- en tubedichting en het ultrasoon reinigen van kast en band. Andere onderdelen, zoals glas, glasdichting, opwindkroon of tube, komen erbij: origineel of generiek, u kiest. De werkelijke slijtage zie ik pas als het horloge helemaal gedemonteerd en gereinigd is.</p>
            <p>Polijsten <span class="num whitespace-nowrap">vanaf € 125,-</span>, alleen bij een servicebeurt.</p>
            <p class="text-xs">{site.naam} is geen officieel Rolex-servicecentrum. Rolex is een geregistreerd merk van Rolex SA.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>
