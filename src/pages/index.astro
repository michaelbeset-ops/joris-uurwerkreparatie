---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Sterren from '../components/Sterren.astro';
import Prijsindicatie from '../components/Prijsindicatie.astro';
import { site, waAfspraak } from '../data/site';
import heroFoto from '../assets/hero/hero-werkbank.jpg';
import houder from '../assets/omega-houder.jpg';
import groen from '../assets/uurwerk-groen.jpg';
import seamaster from '../assets/seamaster.jpg';
import onderdelen from '../assets/onderdelen.jpg';
import kaliber from '../assets/kaliber-321.jpg';

// Alle feiten komen van jorisuurwerkreparatie.nl (bron/site-tekst.txt) of het Google-profiel.
// Wat daar niet staat, is gemarkeerd met [[AANLEVEREN]].
const reviewsUrl = 'https://www.google.com/maps/search/?api=1&query=Joris+Uurwerkreparatie+Herten';

const merken = ['Omega', 'Longines', 'Rado', 'Rolex', 'Hamilton', 'Tissot', 'Mido', 'Certina', 'Nomos', 'Ebel', 'Mühle Glashütte'];

const omegaPunten = [
  'Uitsluitend originele Omega-onderdelen, voor kwaliteit en behoud van waarde',
  'Alle Omega-modellen: Speedmaster, Seamaster, Constellation en De Ville',
  'Ook de kalibers 321, 861, 1861 en 3861 van de Speedmaster Professional',
  'Verkoop van originele Omega-horlogebanden',
];

// Diensten: samengevat uit de servicepagina's voor Omega, Longines en Rado.
const diensten = [
  { id: 'dienst-onderhoud', kop: 'Onderhoud en revisie', tekst: 'Complete servicebeurt: inspectie, schoonmaken, smeren en afstellen, en waar nodig onderdelen vervangen.', foto: groen, alt: 'Geopend chronograafuurwerk op een groene werkmat' },
  { id: 'dienst-reparaties', kop: 'Reparaties', tekst: 'Van een nieuwe kroon of wijzer tot complexe uurwerkreparaties.', foto: onderdelen, alt: 'Losse onderdelen van een gedemonteerd Omega-horloge' },
  { id: 'dienst-polijsten', kop: 'Polijsten en herstel', tekst: 'Kast en band herstellen en polijsten, van staal tot keramiek, met behoud van de originele uitstraling.', foto: seamaster, alt: 'Klassieke Omega Seamaster-chronograaf in een horlogedoos' },
  { id: 'dienst-waterdichtheid', kop: 'Waterdichtheid', tekst: 'Controle en herstel van de waterdichtheid, essentieel voor sportieve en duikmodellen.', icoon: 'druppel' },
  { id: 'dienst-onderdelen', kop: 'Originele onderdelen', tekst: 'Uitsluitend originele onderdelen van het merk, voor kwaliteit en behoud van waarde.', icoon: 'doos' },
];

const stappen = [
  { kop: 'Afspraak maken', tekst: 'Stuur een bericht met merk, type, band, eventueel het referentienummer en een paar foto’s.', icoon: 'kalender' },
  { kop: 'Onderzoek en prijsopgave', tekst: 'Elk horloge wordt eerst zorgvuldig onderzocht. Daarna weet u precies waar u aan toe bent.', icoon: 'loep' },
  { kop: 'Herstel', tekst: 'Gaat u akkoord met de prijsopgave, dan ga ik aan de slag met uw horloge.', icoon: 'pincet' },
  { kop: 'Ophalen', tekst: 'Is het werk klaar, dan haalt u uw horloge op afspraak weer op.', icoon: 'ophalen' },
];

// Waarom: de feiten van hun site, aangevuld met wat Hugo nog moet bevestigen.
const waarom = [
  { kop: 'Officieel Omega Service Center', tekst: 'Vermeld in de officiële OMEGA-zoeker. Onderhoud en reparatie van alle Omega-modellen met originele onderdelen.' },
  { kop: 'Servicecenter Longines en Rado', tekst: 'Binnen de Swatch Group ook voor Hamilton, Mido, Tissot, Certina en ETA-uurwerken.' },
  { kop: 'Eerst onderzoek, dan een prijs', tekst: 'Geen verrassingen achteraf. Onderzoekskosten betaalt u alleen als u de reparatie niet laat uitvoeren.' },
  { kop: 'Niets zonder uw akkoord', tekst: 'Pas als u akkoord gaat met de prijsopgave, begint het werk. Ziet u ervan af, dan haalt u uw horloge op afspraak weer op.' },
  { kop: 'Persoonlijk, op afspraak', tekst: 'U spreekt de horlogemaker zelf, in zijn werkplaats in Herten. Geen balie, geen tussenpersoon.' },
  { kop: 'Geen modemerken of imitaties', tekst: 'Alleen echte horloges van serieuze merken. Geen batterijservice.' },
  // [[AANLEVEREN: garantie, doorlooptijd, verzekerd tijdens reparatie, opsturen mogelijk; toevoegen na bevestiging Hugo]]
];

const rolex = [
  ['Modellen tot 30 jaar', '425'],
  ['Damesmodellen', '450'],
  ['Modellen met GMT-kaliber', '475'],
  ['Modellen van 30 jaar en ouder', '525'],
];
---
<Base title={`${site.naam} | Officieel Omega Service Center in Herten`} description="Officieel Omega Service Center en servicecenter voor Longines en Rado in Herten. Onderhoud en reparatie met originele onderdelen, alleen op afspraak.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero, schermvullend: foto over de volle breedte, de navigatie zweeft erover, kop groot en wit onderin,
         de feiten rechts. De foto (1600 breed) wordt op 1440 kleiner getoond dan de bron. -->
    <section class="donker relative flex min-h-[calc(100svh-6.75rem)] flex-col justify-end overflow-hidden bg-marine text-wit lg:min-h-[calc(100svh-7.25rem)]" aria-labelledby="t-hero">
      <Image src={heroFoto} alt="Een geopend chronograafuurwerk in een houder op de groene werkmat in de werkplaats" widths={[640, 1000, 1600]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover object-[60%_45%]" />
      <div aria-hidden="true" class="absolute inset-0 bg-[linear-gradient(to_top,#0a1d35f2_0%,#0a1d35b3_35%,#0a1d3526_70%,#0a1d3540_100%)] lg:bg-[linear-gradient(to_right,#0a1d35f2_0%,#0a1d35cc_42%,#0a1d3500_75%),linear-gradient(to_top,#0a1d35cc_0%,#0a1d3500_40%)]"></div>
      <div class="wrap relative grid gap-8 pb-24 pt-14 md:pb-12 lg:grid-cols-12 lg:items-end lg:gap-10 lg:pb-16">
        <div class="lg:col-span-8">
          <p class="inline-flex items-center gap-2 rounded-pill bg-wit/12 px-3 py-1.5 text-sm font-medium ring-1 ring-wit/25 backdrop-blur-sm"><Icoon naam="schild" maat={18} class="text-vink-licht" />Officieel Omega Service Center in Herten</p>
          <h1 class="mt-5 max-w-[16ch] text-4xl text-wit">Uw horloge in handen van erkend vakmanschap.</h1>
          <p class="mt-5 max-w-xl text-lg text-wit/90 lg:text-xl">Uw horloge wordt persoonlijk onderzocht en onderhouden door Hugo Joris. U krijgt vooraf een duidelijke prijsopgave en er gebeurt niets zonder uw akkoord. Ook onafhankelijke service voor Rolex, alleen op afspraak.</p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href="#contact" class="btn bg-wit text-marine shadow-zacht hover:bg-ijs">Afspraak maken</a>
            <a href={waAfspraak} class="btn btn-glas"><Icoon naam="bericht" maat={20} />WhatsApp</a>
          </div>
        </div>
        <ul class="grid gap-3 text-wit/90 sm:grid-cols-3 lg:col-span-4 lg:grid-cols-1 lg:justify-items-end lg:text-right">
          <li><a href={reviewsUrl} target="_blank" rel="noopener" class="inline-flex flex-wrap items-center gap-2 no-underline hover:underline lg:justify-end"><Sterren /><strong class="num font-display text-wit">{site.google.score}</strong> op Google ({site.google.aantal})<span class="sr-only"> (opent in een nieuw tabblad)</span></a></li>
          <li class="inline-flex items-center gap-2 lg:justify-end"><Icoon naam="pin" maat={18} />{site.plaats}, alleen op afspraak</li>
          <li><a href={site.telHref} class="num font-display text-2xl font-extrabold text-wit no-underline hover:underline">{site.tel}</a></li>
        </ul>
      </div>
    </section>

    <!-- Merkenrij: alle merken als knoppen, op mobiel swipebaar. Omega uitgelicht. -->
    <nav id="merken" aria-label="Merken" class="scroll-mt-28 border-b border-lijn bg-ijs">
      <ul class="slider wrap items-center py-4 lg:justify-between">
        <li class="mr-2 hidden font-display text-sm font-bold uppercase tracking-[.12em] text-ink-zacht lg:block">Merken</li>
        {merken.map((m) => <li><a href={m === 'Omega' ? '#omega' : m === 'Rolex' ? '#rolex' : '#diensten'} class={`inline-flex h-10 items-center rounded-pill px-4 font-display text-[0.9375rem] font-semibold no-underline ring-1 transition-colors ${m === 'Omega' ? 'bg-marine text-wit ring-marine' : 'bg-wit ring-lijn hover:ring-marine'}`}>{m}</a></li>)}
      </ul>
    </nav>

    <!-- 2. Omega Service Center -->
    <section id="omega" class="scroll-mt-28 py-16 lg:py-24" aria-labelledby="t-omega">
      <div class="wrap grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center lg:gap-10">
        <div class="lg:col-span-6">
          <p class="kicker text-ink-zacht">Omega Service Center</p>
          <h2 id="t-omega" class="mt-3 text-3xl">Wat de Omega-erkenning voor u betekent.</h2>
          <p class="mt-5 text-lg text-ink-zacht">Uw Omega wordt onderhouden door een werkplaats die Omega zelf erkent. Dat betekent originele onderdelen en vakmanschap op het niveau dat het merk vraagt.</p>
          <ul class="mt-7 grid gap-3.5">
            {omegaPunten.map((t) => <li class="flex items-start gap-3"><span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-pill bg-vink/10 text-vink"><Icoon naam="vink" maat={15} dik={3} /></span><span>{t}</span></li>)}
          </ul>
          {/* [[AANLEVEREN: sinds wanneer gecertificeerd en welk niveau (oude site noemt mogelijk "sinds 2017, niveau 3"); pas tonen na bevestiging Hugo]] */}
          <p class="mt-6 text-ink-zacht">Controleer het zelf: Joris Uurwerkreparatie staat in de <a href={site.omegaLocator} target="_blank" rel="noopener" class="font-semibold text-marine underline">officiële OMEGA Service Center-zoeker<span class="sr-only"> (opent in een nieuw tabblad)</span></a>, op Aan de Dijk 126 in Herten.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#contact" class="btn btn-marine">Afspraak voor uw Omega</a>
            <a href="#diensten" class="btn btn-wit">Alle diensten</a>
          </div>
        </div>
        <div class="relative lg:col-span-6">
          <div class="overflow-hidden rounded-2xl shadow-kaart">
            <Image src={houder} alt="Een Omega-uurwerk in een rode Omega-uurwerkhouder, met een Omega-pincet ernaast" widths={[640, 960, 1150]} sizes="(min-width: 1024px) 40vw, 100vw" class="aspect-[4/3] w-full object-cover" />
          </div>
          <div class="kaart absolute -bottom-6 left-4 right-4 flex items-center gap-4 p-4 sm:left-auto sm:right-6 sm:w-80 lg:-left-8 lg:right-auto">
            <span class="icoonvlak"><Icoon naam="schild" maat={26} /></span>
            <p class="leading-snug"><strong class="block font-display">Officieel Omega Service Center</strong><span class="text-sm text-ink-zacht">Originele onderdelen, Omega-gereedschap</span></p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="scroll-mt-28 bg-ijs py-16 lg:py-24" aria-labelledby="t-diensten">
      <div class="wrap grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-32">
            <p class="kicker text-ink-zacht">Diensten</p>
            <h2 id="t-diensten" class="mt-3 text-3xl">Onderhoud en reparatie, met originele onderdelen.</h2>
            <p class="mt-5 text-ink-zacht">Voor Omega, Longines, Rado en de andere merken. Geen modemerken, geen batterijservice en zeker geen imitaties.</p>
            <a href="#contact" class="btn btn-marine mt-7">Afspraak maken</a>
          </div>
        </div>
        <ul class="grid min-w-0 grid-cols-1 gap-4 lg:col-span-8">
          {diensten.map((d) => (
            <li id={d.id} class="scroll-mt-28">
              <a href="#contact" class="group kaart flex items-stretch overflow-hidden no-underline transition-transform duration-200 hover:-translate-y-0.5">
                <span class="relative w-20 shrink-0 overflow-hidden bg-marine-licht min-[400px]:w-24 sm:w-40">
                  {d.foto ? <Image src={d.foto} alt={d.alt} widths={[200, 320]} sizes="10rem" class="absolute inset-0 h-full w-full object-cover" /> : <span class="absolute inset-0 flex items-center justify-center text-marine"><Icoon naam={d.icoon!} maat={36} dik={1.5} /></span>}
                </span>
                <span class="flex min-w-0 flex-1 items-center justify-between gap-4 p-4 sm:p-6">
                  <span class="min-w-0"><span class="block font-display text-lg font-bold leading-tight sm:text-xl">{d.kop}</span><span class="mt-1.5 block text-ink-zacht">{d.tekst}</span></span>
                  <span aria-hidden="true" class="hidden h-10 w-10 shrink-0 items-center justify-center rounded-pill ring-1 ring-lijn transition-colors group-hover:bg-marine group-hover:text-wit group-hover:ring-marine sm:flex"><Icoon naam="pijl" maat={18} dik={2.2} /></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <Prijsindicatie />

    <!-- 4. Werkwijze: donker paneel met vier stappen. -->
    <section id="werkwijze" class="wrap scroll-mt-28 py-16 lg:py-24" aria-labelledby="t-werkwijze">
      <div class="donker relative overflow-hidden rounded-2xl bg-marine px-6 py-12 text-wit md:px-12 lg:px-16 lg:py-20">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="kicker text-staal">Werkwijze</p>
            <h2 id="t-werkwijze" class="mt-3 text-3xl text-wit">Eerst onderzoek, dan pas een prijs.</h2>
          </div>
          <p class="text-staal lg:col-span-5">Aan de prijsopgave zijn onderzoeks- en administratiekosten verbonden. Die betaalt u alleen als u de reparatie niet laat uitvoeren.</p>
        </div>
        <ol class="relative mt-12 grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-6">
          {stappen.map((s, i) => (
            <li class="relative flex gap-5 lg:block">
              {i < stappen.length - 1 && <span aria-hidden="true" class="absolute left-7 top-16 h-[calc(100%-1.5rem)] w-px bg-wit/20 md:hidden lg:left-[4.25rem] lg:top-7 lg:block lg:h-px lg:w-[calc(100%-4.25rem+1.5rem)]"></span>}
              <span class="relative flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-wit text-marine">
                <Icoon naam={s.icoon} maat={26} />
                <span class="num absolute -right-2 -top-2 flex h-6 w-6 items-center justify-center rounded-pill bg-vink-licht font-display text-xs font-bold text-marine-diep">{i + 1}</span>
              </span>
              <div class="lg:mt-6">
                <h3 class="text-lg text-wit"><span class="sr-only">Stap {i + 1}: </span>{s.kop}</h3>
                <p class="mt-2 text-staal">{s.tekst}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 5. Reviews en Over Hugo -->
    <section id="over" class="scroll-mt-28 pb-16 lg:pb-24" aria-labelledby="t-over">
      <div class="wrap grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center lg:gap-10">
        <div class="lg:col-span-5">
          {/* [[AANLEVEREN: portret van Hugo aan de werkbank, staand formaat; vervangt deze foto]] */}
          <figure class="overflow-hidden rounded-2xl shadow-kaart">
            <Image src={kaliber} alt="Een opengewerkt Omega-chronograafuurwerk, kaliber 321, op de werkbank van Hugo Joris" widths={[480, 720]} sizes="(min-width: 1024px) 34vw, 100vw" class="aspect-[4/5] w-full object-cover" />
          </figure>
        </div>
        <div class="lg:col-span-7">
          <p class="kicker text-ink-zacht">Over Hugo Joris</p>
          <h2 id="t-over" class="mt-3 text-3xl">De horlogemaker achter Joris Uurwerkreparatie.</h2>
          <p class="mt-5 text-lg text-ink-zacht">Als officieel Omega Service Center ben ik trots op het vertrouwen dat Omega en veel horlogeliefhebbers in mij stellen. Elk horloge krijgt de aandacht die het verdient, met originele onderdelen.</p>
          {/* [[AANLEVEREN: opleiding, aantal jaren ervaring en sinds wanneer Omega-erkend]] */}
          <div class="kaart mt-8 grid gap-5 p-6 sm:grid-cols-[auto_1fr] sm:items-center sm:gap-8 sm:p-8">
            <div class="text-center sm:text-left">
              <p class="num font-display text-cijfer font-extrabold leading-none">{site.google.score}</p>
              <div class="mt-2"><Sterren maat={20} /></div>
              <p class="mt-1 text-sm text-ink-zacht">{site.google.aantal} beoordelingen</p>
            </div>
            <div>
              <p><strong class="font-display">Klanten op Google</strong> noemen een gepassioneerde uurwerkhersteller met gedegen kennis, en zijn zeer tevreden over onder meer de service van een Longines en een klassieke Rolex.</p>
              <a href={reviewsUrl} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-2 font-display font-bold no-underline hover:underline">Lees de beoordelingen<Icoon naam="pijl" maat={18} dik={2.2} /><span class="sr-only"> (opent in een nieuw tabblad)</span></a>
            </div>
          </div>
          <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-ink-zacht">
            <li class="inline-flex items-center gap-2"><Icoon naam="pin" maat={18} class="text-marine" />Werkplaats in {site.plaats}</li>
            <li class="inline-flex items-center gap-2"><Icoon naam="kaart" maat={18} class="text-marine" />Limburg, Brabant, België en Duitsland</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 6. Waarom -->
    <section class="wrap pb-16 lg:pb-24" aria-labelledby="t-waarom">
      <div class="rounded-2xl bg-ijs p-6 md:p-10 lg:p-14">
        <div class="grid gap-10 lg:grid-cols-3 lg:gap-12">
          <div>
            <div class="lg:sticky lg:top-32">
              <h2 id="t-waarom" class="text-3xl">Waarom kiezen voor Joris?</h2>
              <p class="mt-5 text-ink-zacht">Een kostbaar horloge geeft u niet zomaar uit handen. Dit kunt u van de werkplaats verwachten.</p>
            </div>
          </div>
          <ul class="grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:col-span-2">
            {waarom.map((w) => (
              <li class="flex gap-4">
                <span class="icoonvlak bg-wit shadow-zacht"><Icoon naam="schild" maat={24} /></span>
                <span><h3 class="text-lg">{w.kop}</h3><span class="mt-1.5 block text-ink-zacht">{w.tekst}</span></span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 7. Rolex, compact -->
    <section id="rolex" class="scroll-mt-28 border-t border-lijn py-16 lg:py-24" aria-labelledby="t-rolex">
      <div class="wrap grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-start lg:gap-10">
        <div class="lg:col-span-5">
          <p class="kicker text-ink-zacht">Rolex</p>
          <h2 id="t-rolex" class="mt-3 text-3xl">Onafhankelijke service voor uw Rolex.</h2>
          <p class="mt-5 text-ink-zacht">Onderhoud door Hugo Joris in de werkplaats in Herten, met vaste prijzen per type model. Voor Submariner, Datejust, Day-Date, Air-King, GMT-Master, Explorer, Oyster Perpetual en Super Precision.</p>
          <div class="mt-6 rounded-xl bg-marine-licht p-5">
            <p class="flex items-center gap-2 font-display font-bold text-marine"><Icoon naam="doos" maat={20} />Origineel of generiek: u kiest</p>
            <p class="mt-2 text-sm text-ink">De werkelijke slijtage is pas te zien als het horloge gedemonteerd en gereinigd is. Moeten er onderdelen bij, dan krijgt u twee keuzes: origineel of generiek. Bij een waardevol of verzamelwaardig horloge kan dat verschil maken voor originaliteit en waarde. Dat bespreken we vooraf.</p>
          </div>
          <p class="mt-5 text-sm font-medium text-ink">Joris Uurwerkreparatie is geen officieel Rolex-servicecentrum.</p>
        </div>
        <div class="kaart min-w-0 p-5 sm:p-8 lg:col-span-7">
          <table class="w-full text-left">
            <caption class="sr-only">Prijzen Rolex-servicebeurt</caption>
            <thead><tr class="border-b border-lijn text-sm text-ink-zacht"><th scope="col" class="pb-3 font-medium">Model</th><th scope="col" class="pb-3 text-right font-medium">Servicebeurt</th></tr></thead>
            <tbody>
              {rolex.map(([m, p]) => (
                <tr class="border-b border-lijn">
                  <th scope="row" class="py-4 pr-4 font-normal">{m}</th>
                  <td class="num py-4 text-right font-display text-lg font-bold sm:whitespace-nowrap">vanaf € {p},-</td>
                </tr>
              ))}
            </tbody>
          </table>
          <ul class="mt-6 grid gap-2.5 text-ink-zacht">
            <li class="flex gap-3"><Icoon naam="vink" maat={18} dik={2.6} class="mt-1 text-vink" /><span>Inclusief opwindveer, achterdekseldichting, kroon- en tubedichting en ultrasoon reinigen van kast en band.</span></li>
            <li class="flex gap-3"><Icoon naam="vink" maat={18} dik={2.6} class="mt-1 text-vink" /><span>Andere onderdelen, zoals glas, glasdichting, opwindkroon of tube, komen erbij na uw akkoord.</span></li>
            <li class="flex gap-3"><Icoon naam="vink" maat={18} dik={2.6} class="mt-1 text-vink" /><span>Polijsten <span class="num whitespace-nowrap">vanaf € 125,-</span>, alleen bij een servicebeurt en alleen als u dat wilt. GMT-modellen van 30 jaar en ouder: <span class="num whitespace-nowrap">€ 50,-</span> extra.</span></li>
          </ul>
          <p class="mt-6 border-t border-lijn pt-4 text-xs text-ink-zacht">{site.naam} is geen officieel Rolex-servicecentrum. Rolex is een geregistreerd merk van Rolex SA.</p>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>
